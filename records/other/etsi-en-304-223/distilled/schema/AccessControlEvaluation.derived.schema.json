{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:etsi-en-304-223:AccessControlEvaluation",
  "title": "AccessControlEvaluation",
  "description": "DERIVED from distilled/messages.yaml (§5.2.2); the EN defines no schema and no encoding. Evaluation of the organization's access control frameworks and the measures identified to secure AI assets.",
  "type": "object",
  "properties": {
    "frameworks_evaluated": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "access control frameworks evaluated",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0045"
      ]
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "API",
              "model",
              "data",
              "training pipeline",
              "processing pipeline"
            ],
            "description": "what the measure secures",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0045"
            ]
          },
          "measure": {
            "type": "string",
            "minLength": 1,
            "description": "the measure identified",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0045"
            ]
          }
        },
        "required": [
          "target",
          "measure"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "appropriate measures identified, per asset class",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0045"
      ]
    }
  },
  "required": [
    "frameworks_evaluated",
    "measures"
  ],
  "additionalProperties": false
}
