{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:etsi-en-304-223:UndocumentedComponentJustification",
  "title": "UndocumentedComponentJustification",
  "description": "DERIVED from distilled/messages.yaml (§5.2.3); the EN defines no schema and no encoding. Justification and mitigation for using models or components that are not well-documented or secured.",
  "type": "object",
  "properties": {
    "component_ref": {
      "type": "string",
      "minLength": 1,
      "description": "the model or component",
      "x-obligation": "inferred",
      "x-inferred-reason": "the source defines no identifier",
      "x-constrained-by": [
        "etsi-en-304-223#R-0054"
      ]
    },
    "justification_documentation": {
      "type": "string",
      "minLength": 1,
      "description": "documentation justifying the decision to use it",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0054"
      ]
    },
    "mitigating_controls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "mitigating controls",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0055"
      ]
    },
    "risk_assessment": {
      "type": "string",
      "minLength": 1,
      "description": "risk assessment linked to the model or component",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0055"
      ]
    },
    "shared_with_end_users": {
      "type": "boolean",
      "const": true,
      "description": "the documentation is shared with End-users in an accessible way",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0056"
      ]
    }
  },
  "required": [
    "justification_documentation",
    "mitigating_controls",
    "risk_assessment",
    "shared_with_end_users"
  ],
  "additionalProperties": false
}
