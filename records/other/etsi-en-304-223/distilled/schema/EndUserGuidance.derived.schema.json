{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:etsi-en-304-223:EndUserGuidance",
  "title": "EndUserGuidance",
  "description": "DERIVED from distilled/messages.yaml (§5.3.1, §5.1.4); the EN defines no schema and no encoding. Accessible guidance for End-users on using, managing, integrating and configuring the AI system.",
  "type": "object",
  "properties": {
    "use_guidance": {
      "type": "string",
      "minLength": 1,
      "description": "guidance on use",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0075"
      ]
    },
    "management_guidance": {
      "type": "string",
      "minLength": 1,
      "description": "guidance on management",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0075"
      ]
    },
    "integration_guidance": {
      "type": "string",
      "minLength": 1,
      "description": "guidance on integration",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0075"
      ]
    },
    "configuration_guidance": {
      "type": "string",
      "minLength": 1,
      "description": "guidance on configuration",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0075"
      ]
    },
    "appropriate_use": {
      "type": "string",
      "minLength": 1,
      "description": "guidance on the appropriate use of the model or system",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0077"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "limitations highlighted",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0077"
      ]
    },
    "potential_failure_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "potential failure modes highlighted",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0077"
      ]
    },
    "prohibited_use_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "prohibited use cases of the AI system End-users are made aware of",
      "x-obligation": "should",
      "x-constrained-by": [
        "etsi-en-304-223#R-0036"
      ]
    },
    "developer_supplied_information": {
      "type": "string",
      "minLength": 1,
      "description": "all necessary information the Developer provides to the System Operator",
      "x-obligation": "shall",
      "x-condition": "where the Developer is an external entity",
      "x-constrained-by": [
        "etsi-en-304-223#R-0076"
      ]
    }
  },
  "required": [
    "use_guidance",
    "management_guidance",
    "integration_guidance",
    "configuration_guidance",
    "appropriate_use",
    "limitations",
    "potential_failure_modes"
  ],
  "additionalProperties": false
}
