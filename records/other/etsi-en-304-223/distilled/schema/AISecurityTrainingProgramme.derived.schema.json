{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:etsi-en-304-223:AISecurityTrainingProgramme",
  "title": "AISecurityTrainingProgramme",
  "description": "DERIVED from distilled/messages.yaml (§5.1.1); the EN defines no schema and no encoding. The cyber security training programme and its AI security content.",
  "type": "object",
  "properties": {
    "ai_security_content": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "AI security content included in the training programme",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0104"
      ]
    },
    "content_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewed_at": {
            "type": "string",
            "format": "date-time",
            "description": "when a review took place",
            "x-obligation": "inferred",
            "x-inferred-reason": "the source requires regular review and update but names no record of it; a dated entry is the minimal evidence",
            "x-constrained-by": [
              "etsi-en-304-223#R-0105"
            ]
          },
          "update_trigger": {
            "type": "string",
            "minLength": 1,
            "description": "what prompted an update, e.g. new substantial AI-related security threats",
            "x-obligation": "inferred",
            "x-inferred-reason": "the source gives new substantial AI-related security threats only as an example (such as) of when to review and update; it asks for no record of the trigger",
            "x-constrained-by": [
              "etsi-en-304-223#R-0105"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "the regular review and update of that content",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0105"
      ]
    },
    "role_tailoring": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "the role or responsibility",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0007"
            ]
          },
          "tailored_content": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "content tailored to that role",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0007"
            ]
          }
        },
        "required": [
          "role",
          "tailored_content"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "training tailored to the roles and responsibilities of staff",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0007"
      ]
    },
    "staff_awareness_topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "latest AI-related security threats and vulnerabilities all staff must stay aware of",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0008"
      ]
    },
    "proposed_mitigations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "proposed mitigations for those threats",
      "x-obligation": "shall",
      "x-condition": "where available",
      "x-constrained-by": [
        "etsi-en-304-223#R-0009"
      ]
    },
    "communication_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "channels used to communicate updates (bulletins, newsletters, knowledge-sharing platforms)",
      "x-obligation": "should",
      "x-constrained-by": [
        "etsi-en-304-223#R-0010"
      ]
    },
    "developer_training_topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "secure coding and system design techniques specific to AI development, aimed at preventing and mitigating vulnerabilities in algorithms, models and associated software",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0011"
      ]
    }
  },
  "required": [
    "ai_security_content",
    "content_reviews",
    "role_tailoring",
    "staff_awareness_topics",
    "developer_training_topics"
  ],
  "additionalProperties": false
}
