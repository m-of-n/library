{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:etsi-en-304-223:SystemAndUserActionLog",
  "title": "SystemAndUserActionLog",
  "description": "DERIVED from distilled/messages.yaml (§5.4.2); the EN defines no schema and no encoding. Log of system and user actions supporting security compliance, incident investigation and vulnerability remediation.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_kind": {
            "type": "string",
            "enum": [
              "system",
              "user"
            ],
            "description": "system or user action",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0086"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "description": "the action logged",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0086"
            ]
          },
          "logged_at": {
            "type": "string",
            "format": "date-time",
            "description": "when the action occurred",
            "x-obligation": "inferred",
            "x-inferred-reason": "a log supporting incident investigation is time-ordered; the source lists no log fields",
            "x-constrained-by": [
              "etsi-en-304-223#R-0086"
            ]
          }
        },
        "required": [
          "actor_kind",
          "action"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "logged actions",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0086"
      ]
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
