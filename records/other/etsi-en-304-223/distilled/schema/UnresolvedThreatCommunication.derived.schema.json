{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:etsi-en-304-223:UnresolvedThreatCommunication",
  "title": "UnresolvedThreatCommunication",
  "description": "DERIVED from distilled/messages.yaml (§5.1.3); the EN defines no schema and no encoding. Communication of AI security threats that Developers cannot resolve.",
  "type": "object",
  "properties": {
    "threat_description": {
      "type": "string",
      "minLength": 1,
      "description": "the unresolved threat",
      "x-obligation": "inferred",
      "x-inferred-reason": "the source requires the threat to be communicated but defines no field for identifying it",
      "x-constrained-by": [
        "etsi-en-304-223#R-0110",
        "etsi-en-304-223#R-0111"
      ]
    },
    "communicated_to_system_operators": {
      "type": "boolean",
      "const": true,
      "description": "threat communicated by the Developer to System Operators so they can threat model",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0111"
      ]
    },
    "communicated_to_end_users": {
      "type": "boolean",
      "const": true,
      "description": "threat communicated by the System Operator to End-users",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0028"
      ]
    },
    "risk_descriptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "detailed descriptions of the risks",
      "x-obligation": "should",
      "x-constrained-by": [
        "etsi-en-304-223#R-0029"
      ]
    },
    "potential_impacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "potential impacts",
      "x-obligation": "should",
      "x-constrained-by": [
        "etsi-en-304-223#R-0029"
      ]
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "recommended actions to address or monitor the threats",
      "x-obligation": "should",
      "x-constrained-by": [
        "etsi-en-304-223#R-0029"
      ]
    }
  },
  "required": [
    "communicated_to_system_operators",
    "communicated_to_end_users"
  ],
  "additionalProperties": false
}
