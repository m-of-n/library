{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:etsi-en-304-223:AuditTrail",
  "title": "AuditTrail",
  "description": "DERIVED from distilled/messages.yaml (§5.2.4, §5.1.2); the EN defines no schema and no encoding. The audit trail of the AI system: design, post-deployment maintenance plans, and the operation and lifecycle management of models, datasets and prompts.",
  "type": "object",
  "properties": {
    "system_design": {
      "type": "string",
      "minLength": 1,
      "description": "documentation of the system design",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0059"
      ]
    },
    "post_deployment_maintenance_plans": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "post-deployment maintenance plans",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0059"
      ]
    },
    "incorporated_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_kind": {
            "type": "string",
            "enum": [
              "model",
              "dataset",
              "prompt"
            ],
            "description": "model, dataset or prompt",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0016"
            ]
          },
          "item_ref": {
            "type": "string",
            "minLength": 1,
            "description": "identifier of the item",
            "x-obligation": "inferred",
            "x-inferred-reason": "an audit trail entry must say which item it concerns; the source defines no identifier",
            "x-constrained-by": [
              "etsi-en-304-223#R-0016"
            ]
          },
          "operation_records": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "operation of the item",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0016"
            ]
          },
          "lifecycle_management_records": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "lifecycle management of the item",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0016"
            ]
          }
        },
        "required": [
          "item_kind",
          "operation_records",
          "lifecycle_management_records"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "models, datasets and prompts incorporated into the system",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0015"
      ]
    },
    "available_to_downstream": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "downstream System Operators and Data Custodians given access to the documentation",
      "x-obligation": "should",
      "x-constrained-by": [
        "etsi-en-304-223#R-0060"
      ]
    }
  },
  "required": [
    "system_design",
    "post_deployment_maintenance_plans",
    "incorporated_items"
  ],
  "additionalProperties": false
}
