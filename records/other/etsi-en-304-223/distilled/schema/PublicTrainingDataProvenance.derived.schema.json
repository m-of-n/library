{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:etsi-en-304-223:PublicTrainingDataProvenance",
  "title": "PublicTrainingDataProvenance",
  "description": "DERIVED from distilled/messages.yaml (§5.2.4); the EN defines no schema and no encoding. Documentation of how training data from publicly available sources was obtained.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "how_obtained": {
            "type": "string",
            "minLength": 1,
            "description": "how the public training data was obtained",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0063"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "description": "where the data came from",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0063"
            ]
          },
          "use_in_model": {
            "type": "string",
            "minLength": 1,
            "description": "how the data is used in the model",
            "x-obligation": "shall",
            "x-constrained-by": [
              "etsi-en-304-223#R-0063"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "at a minimum the source, such as the URL of the scraped page",
            "x-obligation": "should",
            "x-constrained-by": [
              "etsi-en-304-223#R-0064"
            ]
          },
          "obtained_at": {
            "type": "string",
            "format": "date-time",
            "description": "date and time the data was obtained",
            "x-obligation": "should",
            "x-constrained-by": [
              "etsi-en-304-223#R-0064"
            ]
          }
        },
        "required": [
          "how_obtained",
          "origin",
          "use_in_model"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "one entry per publicly sourced training dataset",
      "x-obligation": "shall",
      "x-constrained-by": [
        "etsi-en-304-223#R-0063"
      ]
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
