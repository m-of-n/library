{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:etsi-en-304-223:PromptAndConfigurationAuditLog",
  "title": "PromptAndConfigurationAuditLog",
  "description": "DERIVED from distilled/messages.yaml (§5.2.4); the EN defines no schema and no encoding. Audit log of changes to system prompts or other model configuration that affect how the system works.",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "changed_item": {
            "type": "string",
            "minLength": 1,
            "description": "the system prompt or model configuration changed",
            "x-obligation": "should",
            "x-constrained-by": [
              "etsi-en-304-223#R-0065"
            ]
          },
          "change_description": {
            "type": "string",
            "minLength": 1,
            "description": "the change",
            "x-obligation": "should",
            "x-constrained-by": [
              "etsi-en-304-223#R-0065"
            ]
          },
          "changed_at": {
            "type": "string",
            "format": "date-time",
            "description": "when the change was made",
            "x-obligation": "inferred",
            "x-inferred-reason": "an audit log is ordered by time; the source does not list log fields",
            "x-constrained-by": [
              "etsi-en-304-223#R-0065"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "description": "changes to system prompts or other model configuration (including prompts)",
      "x-obligation": "should",
      "x-constrained-by": [
        "etsi-en-304-223#R-0065"
      ]
    },
    "available_to": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "System Operators and End-Users with access to the model who are given the log",
      "x-obligation": "can",
      "x-constrained-by": [
        "etsi-en-304-223#R-0066"
      ]
    }
  },
  "required": [],
  "additionalProperties": false
}
