{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:slsa-1-2:provenance-v1.derived",
  "title": "SLSA Build Provenance v1 in-toto Statement (DERIVED)",
  "$comment": "DERIVED by the library from SLSA v1.2 build-provenance.md (field tables + cue/proto summaries, which the spec says are informative; the text is authoritative). Encodes: REQUIRED for SLSA Build L1 field sets (R-0186, R-0187, R-0207, R-0210); unrecognised fields ignored (R-0184) so additionalProperties stays open; predicateType constant. Level-dependent rules (externalParameters completeness at L3, control-plane generation, signatures) are NOT expressible here \u2014 see requirements.yaml.",
  "type": "object",
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ResourceDescriptor"
      }
    },
    "predicateType": {
      "const": "https://slsa.dev/provenance/v1"
    },
    "predicate": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "$defs": {
    "ResourceDescriptor": {
      "$comment": "in-toto ResourceDescriptor as summarised in SLSA build-provenance.md #ResourceDescriptor (cue). in-toto's own rule that at least one of uri/digest/content is set is NOT stated in SLSA and is not enforced here.",
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "digest": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "sha256": {
              "type": "string"
            },
            "sha512": {
              "type": "string"
            },
            "gitCommit": {
              "type": "string"
            }
          }
        },
        "name": {
          "type": "string"
        },
        "downloadLocation": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "$comment": "#Timestamp: <YYYY>-<MM>-<DD>T<hh>:<mm>:<ss>Z (build-provenance.md cue summary)"
    },
    "Provenance": {
      "type": "object",
      "required": [
        "buildDefinition",
        "runDetails"
      ],
      "properties": {
        "buildDefinition": {
          "$ref": "#/$defs/BuildDefinition"
        },
        "runDetails": {
          "$ref": "#/$defs/RunDetails"
        }
      }
    },
    "BuildDefinition": {
      "type": "object",
      "required": [
        "buildType",
        "externalParameters"
      ],
      "properties": {
        "buildType": {
          "type": "string",
          "$comment": "TypeURI"
        },
        "externalParameters": {
          "type": "object"
        },
        "internalParameters": {
          "type": "object"
        },
        "resolvedDependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceDescriptor"
          }
        }
      }
    },
    "RunDetails": {
      "type": "object",
      "required": [
        "builder"
      ],
      "properties": {
        "builder": {
          "$ref": "#/$defs/Builder"
        },
        "metadata": {
          "$ref": "#/$defs/BuildMetadata"
        },
        "byproducts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceDescriptor"
          }
        }
      }
    },
    "Builder": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "$comment": "TypeURI; sole determiner of Build level"
        },
        "builderDependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceDescriptor"
          }
        },
        "version": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "BuildMetadata": {
      "type": "object",
      "required": [],
      "properties": {
        "invocationId": {
          "type": "string"
        },
        "startedOn": {
          "$ref": "#/$defs/Timestamp"
        },
        "finishedOn": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    }
  }
}
