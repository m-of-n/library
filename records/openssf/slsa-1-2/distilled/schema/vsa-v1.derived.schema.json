{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:slsa-1-2:vsa-v1.derived",
  "title": "SLSA Verification Summary Attestation v1 in-toto Statement (DERIVED)",
  "$comment": "DERIVED from SLSA v1.2 verification_summary.md 'Fields' (required/optional markers) and the jsonc schema sketch held verbatim in vsa-v1.verbatim.jsonc. Unrecognised fields are ignored (R-0226).",
  "type": "object",
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$comment": "in-toto ResourceDescriptor as summarised in SLSA build-provenance.md #ResourceDescriptor (cue). in-toto's own rule that at least one of uri/digest/content is set is NOT stated in SLSA and is not enforced here.",
        "type": "object",
        "properties": {
          "uri": {
            "type": "string"
          },
          "digest": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "properties": {
              "sha256": {
                "type": "string"
              },
              "sha512": {
                "type": "string"
              },
              "gitCommit": {
                "type": "string"
              }
            }
          },
          "name": {
            "type": "string"
          },
          "downloadLocation": {
            "type": "string"
          },
          "mediaType": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "annotations": {
            "type": "object"
          }
        }
      }
    },
    "predicateType": {
      "const": "https://slsa.dev/verification_summary/v1"
    },
    "predicate": {
      "type": "object",
      "required": [
        "verifier",
        "resourceUri",
        "policy",
        "verificationResult",
        "verifiedLevels"
      ],
      "properties": {
        "verifier": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "timeVerified": {
          "type": "string",
          "format": "date-time",
          "$comment": "#Timestamp: <YYYY>-<MM>-<DD>T<hh>:<mm>:<ss>Z (build-provenance.md cue summary)"
        },
        "resourceUri": {
          "type": "string"
        },
        "policy": {
          "$comment": "in-toto ResourceDescriptor as summarised in SLSA build-provenance.md #ResourceDescriptor (cue). in-toto's own rule that at least one of uri/digest/content is set is NOT stated in SLSA and is not enforced here.",
          "type": "object",
          "properties": {
            "uri": {
              "type": "string"
            },
            "digest": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "properties": {
                "sha256": {
                  "type": "string"
                },
                "sha512": {
                  "type": "string"
                },
                "gitCommit": {
                  "type": "string"
                }
              }
            },
            "name": {
              "type": "string"
            },
            "downloadLocation": {
              "type": "string"
            },
            "mediaType": {
              "type": "string"
            },
            "content": {
              "type": "string",
              "contentEncoding": "base64"
            },
            "annotations": {
              "type": "object"
            }
          },
          "required": [
            "uri"
          ]
        },
        "inputAttestations": {
          "type": "array",
          "items": {
            "$comment": "in-toto ResourceDescriptor as summarised in SLSA build-provenance.md #ResourceDescriptor (cue). in-toto's own rule that at least one of uri/digest/content is set is NOT stated in SLSA and is not enforced here.",
            "type": "object",
            "properties": {
              "uri": {
                "type": "string"
              },
              "digest": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "properties": {
                  "sha256": {
                    "type": "string"
                  },
                  "sha512": {
                    "type": "string"
                  },
                  "gitCommit": {
                    "type": "string"
                  }
                }
              },
              "name": {
                "type": "string"
              },
              "downloadLocation": {
                "type": "string"
              },
              "mediaType": {
                "type": "string"
              },
              "content": {
                "type": "string",
                "contentEncoding": "base64"
              },
              "annotations": {
                "type": "object"
              }
            },
            "required": [
              "digest"
            ]
          }
        },
        "verificationResult": {
          "enum": [
            "PASSED",
            "FAILED"
          ]
        },
        "verifiedLevels": {
          "type": "array",
          "items": {
            "type": "string",
            "$comment": "SlsaResult: SHOULD be SLSA_<TRACK>_LEVEL_<n> or SLSA_<TRACK>_LEVEL_UNEVALUATED, or FAILED; Verified Properties (SLSA_SOURCE_TWO_PARTY_REVIEWED, SLSA_BUILD_REPRODUCED); custom values MAY be used but MUST NOT start with SLSA_ (R-0243). The pattern enforces only the MUST NOT.",
            "pattern": "^(?!SLSA_)|^SLSA_[A-Z]+_LEVEL_([0-9]+|UNEVALUATED)$|^SLSA_SOURCE_TWO_PARTY_REVIEWED$|^SLSA_BUILD_REPRODUCED$"
          }
        },
        "dependencyLevels": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "propertyNames": {
            "type": "string",
            "$comment": "SlsaResult: SHOULD be SLSA_<TRACK>_LEVEL_<n> or SLSA_<TRACK>_LEVEL_UNEVALUATED, or FAILED; Verified Properties (SLSA_SOURCE_TWO_PARTY_REVIEWED, SLSA_BUILD_REPRODUCED); custom values MAY be used but MUST NOT start with SLSA_ (R-0243). The pattern enforces only the MUST NOT.",
            "pattern": "^(?!SLSA_)|^SLSA_[A-Z]+_LEVEL_([0-9]+|UNEVALUATED)$|^SLSA_SOURCE_TWO_PARTY_REVIEWED$|^SLSA_BUILD_REPRODUCED$"
          }
        },
        "slsaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
