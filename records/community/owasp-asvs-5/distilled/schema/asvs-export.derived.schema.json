{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:owasp-asvs-5:asvs-export.derived",
  "title": "ASVS 5.0.0 nested JSON export (OWASP_Application_Security_Verification_Standard_5.0.0_en.json) — DERIVED",
  "description": "DERIVED by the library from the 5.0.0 release asset; OWASP publishes no schema for its exports. Validates the asset byte-for-byte as released (sha256 bcdbec21...cb35). The same tree is also published as XML (<root>/<Requirements>/<item>...) with identical element names.",
  "type": "object",
  "required": ["Name", "ShortName", "Version", "Description", "Requirements"],
  "additionalProperties": false,
  "properties": {
    "Name": {"type": "string", "const": "Application Security Verification Standard Project"},
    "ShortName": {"type": "string", "const": "ASVS"},
    "Version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "Description": {"type": "string"},
    "Requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Chapter"}}
  },
  "$defs": {
    "Chapter": {
      "type": "object",
      "required": ["Shortcode", "Ordinal", "ShortName", "Name", "Items"],
      "additionalProperties": false,
      "properties": {
        "Shortcode": {"type": "string", "pattern": "^V\\d+$"},
        "Ordinal": {"type": "integer", "minimum": 1},
        "ShortName": {"type": "string"},
        "Name": {"type": "string"},
        "Items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Section"}}
      }
    },
    "Section": {
      "type": "object",
      "required": ["Shortcode", "Ordinal", "Name", "Items"],
      "additionalProperties": false,
      "properties": {
        "Shortcode": {"type": "string", "pattern": "^V\\d+\\.\\d+$"},
        "Ordinal": {"type": "integer", "minimum": 1},
        "Name": {"type": "string"},
        "Items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Requirement"}}
      }
    },
    "Requirement": {
      "type": "object",
      "required": ["Shortcode", "Ordinal", "Description", "L"],
      "additionalProperties": false,
      "properties": {
        "Shortcode": {"type": "string", "pattern": "^V\\d+\\.\\d+\\.\\d+$"},
        "Ordinal": {"type": "integer", "minimum": 1},
        "Description": {"type": "string", "pattern": "^Verify "},
        "L": {"type": "string", "enum": ["1", "2", "3"], "description": "lowest level at which the requirement applies; levels are cumulative"}
      }
    }
  }
}
