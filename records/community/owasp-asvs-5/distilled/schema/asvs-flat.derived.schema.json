{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:owasp-asvs-5:asvs-flat.derived",
  "title": "ASVS 5.0.0 flat JSON export (..._5.0.0_en.flat.json) — DERIVED",
  "description": "DERIVED by the library; OWASP publishes no schema. One row per requirement; the CSV export (..._5.0.0_en.csv) has exactly these seven columns in this order: chapter_id, chapter_name, section_id, section_name, req_id, req_description, L.",
  "type": "object",
  "required": ["requirements"],
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter_id", "chapter_name", "section_id", "section_name", "req_id", "req_description", "L"],
        "additionalProperties": false,
        "properties": {
          "chapter_id": {"type": "string", "pattern": "^V\\d+$"},
          "chapter_name": {"type": "string"},
          "section_id": {"type": "string", "pattern": "^V\\d+\\.\\d+$"},
          "section_name": {"type": "string"},
          "req_id": {"type": "string", "pattern": "^V\\d+\\.\\d+\\.\\d+$"},
          "req_description": {"type": "string"},
          "L": {"type": "string", "enum": ["1", "2", "3"]}
        }
      }
    }
  }
}
