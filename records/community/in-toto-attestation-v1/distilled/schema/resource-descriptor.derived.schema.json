{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:in-toto-attestation-v1:resource-descriptor.derived",
  "title": "in-toto ResourceDescriptor (derived)",
  "description": "DERIVED - not verbatim. resource_descriptor.md 4.1-4.2 (rendering 240-330): all fields optional except that one of uri, digest, content MUST be present.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "uri": {
      "$ref": "#/$defs/ResourceURI"
    },
    "digest": {
      "$ref": "#/$defs/DigestSet"
    },
    "content": {
      "type": "string",
      "pattern": "^(?:(?:[A-Za-z0-9+/][A-Za-z0-9+/][A-Za-z0-9+/][A-Za-z0-9+/])*(?:[A-Za-z0-9+/][A-Za-z0-9+/](?:==)?|[A-Za-z0-9+/][A-Za-z0-9+/][A-Za-z0-9+/]=?)?|(?:[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-])*(?:[A-Za-z0-9_-][A-Za-z0-9_-](?:==)?|[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-]=?)?)$"
    },
    "downloadLocation": {
      "$ref": "#/$defs/ResourceURI"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[^\\s/;]+/[^\\s/;]+(?:;.*)?$"
    },
    "annotations": {
      "type": "object"
    }
  },
  "anyOf": [
    {
      "required": [
        "uri"
      ]
    },
    {
      "required": [
        "digest"
      ]
    },
    {
      "required": [
        "content"
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "ResourceURI": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.\\-]*:(?:(?!//)|//[^A-Z/?#\\s]*(?:[/?#]|$))\\S*$"
    },
    "DigestSet": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha224": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha384": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha512": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha512_224": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha512_256": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha3_224": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha3_256": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha3_384": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha3_512": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "shake128": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "shake256": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "blake2b": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "blake2s": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "ripemd160": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sm3": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "gost": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "sha1": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "md5": {
          "type": "string",
          "pattern": "^(?:[0-9a-f][0-9a-f])+$"
        },
        "gitCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "gitTree": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "gitBlob": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "gitTag": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "dirHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
