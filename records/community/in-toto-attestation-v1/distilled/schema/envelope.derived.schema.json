{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:in-toto-attestation-v1:envelope.derived",
  "title": "in-toto Envelope, DSSE as used (derived)",
  "description": "DERIVED - not verbatim. envelope.md 8.1-8.2 (rendering 748-798) plus docs/validation.md (rendering 1137-1141) for the DSSE field names signature.keyid and signature.sig (the DSSE v1.0 text itself is not in the source). payloadType is application/vnd.in-toto+json or application/vnd.in-toto.<predicate>+json; payload is base64.",
  "type": "object",
  "required": [
    "payloadType",
    "payload",
    "signatures"
  ],
  "properties": {
    "payloadType": {
      "type": "string",
      "pattern": "^application/vnd\\.in-toto(?:\\.[^\\s/+]+)?\\+json$"
    },
    "payload": {
      "type": "string",
      "pattern": "^(?:(?:[A-Za-z0-9+/][A-Za-z0-9+/][A-Za-z0-9+/][A-Za-z0-9+/])*(?:[A-Za-z0-9+/][A-Za-z0-9+/](?:==)?|[A-Za-z0-9+/][A-Za-z0-9+/][A-Za-z0-9+/]=?)?|(?:[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-])*(?:[A-Za-z0-9_-][A-Za-z0-9_-](?:==)?|[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-]=?)?)$"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sig"
        ],
        "properties": {
          "keyid": {
            "type": "string"
          },
          "sig": {
            "type": "string",
            "pattern": "^(?:(?:[A-Za-z0-9+/][A-Za-z0-9+/][A-Za-z0-9+/][A-Za-z0-9+/])*(?:[A-Za-z0-9+/][A-Za-z0-9+/](?:==)?|[A-Za-z0-9+/][A-Za-z0-9+/][A-Za-z0-9+/]=?)?|(?:[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-])*(?:[A-Za-z0-9_-][A-Za-z0-9_-](?:==)?|[A-Za-z0-9_-][A-Za-z0-9_-][A-Za-z0-9_-]=?)?)$"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
