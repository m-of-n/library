{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:in-toto-attestation-v1:digest-set-lengths.derived",
  "title": "in-toto DigestSet with algorithm output lengths (derived)",
  "description": "DERIVED - not verbatim. digest-set plus the output length of each single-size algorithm. The source states NO lengths for the standard algorithms; these come from the algorithm definitions. The Go and Rust bindings check 12 of the 14 (not ripemd160 or sm3).",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha224": {
      "type": "string",
      "pattern": "^[0-9a-f]{56}$"
    },
    "sha384": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "sha512_224": {
      "type": "string",
      "pattern": "^[0-9a-f]{56}$"
    },
    "sha512_256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha3_224": {
      "type": "string",
      "pattern": "^[0-9a-f]{56}$"
    },
    "sha3_256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha3_384": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "sha3_512": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "shake128": {
      "type": "string",
      "pattern": "^(?:[0-9a-f][0-9a-f])+$"
    },
    "shake256": {
      "type": "string",
      "pattern": "^(?:[0-9a-f][0-9a-f])+$"
    },
    "blake2b": {
      "type": "string",
      "pattern": "^(?:[0-9a-f][0-9a-f])+$"
    },
    "blake2s": {
      "type": "string",
      "pattern": "^(?:[0-9a-f][0-9a-f])+$"
    },
    "ripemd160": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sm3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gost": {
      "type": "string",
      "pattern": "^(?:[0-9a-f][0-9a-f])+$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "gitTree": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "gitBlob": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "gitTag": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "dirHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": {
    "type": "string"
  }
}
