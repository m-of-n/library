{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:in-toto-attestation-v1:field-types.derived",
  "title": "in-toto field types (derived)",
  "description": "DERIVED - not verbatim. field_types.md 6.1-6.3 (rendering 637-690): validate against #/$defs/ResourceURI, #/$defs/TypeURI or #/$defs/Timestamp.",
  "$defs": {
    "TypeURI": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.\\-]*:(?:(?!//)|//[^A-Z/?#\\s]*(?:[/?#]|$))\\S*$"
    },
    "ResourceURI": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.\\-]*:(?:(?!//)|//[^A-Z/?#\\s]*(?:[/?#]|$))\\S*$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(?:\\.[0-9]+)?Z$"
    }
  }
}
