{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:owasp-dsomm:dimension.derived",
  "title": "DSOMM dimension (mapping of sub-dimension name to sub-dimension) - DERIVED",
  "description": "DERIVED by the library from the file's contents; no published schema binds generated/model.yaml (the publisher's own JSON Schemas (draft-07, src/assets/YAML/schemas/ at the same tag) describe its per-dimension source files, where implementation items are $ref links, and reject generated/model.yaml, which inlines them). Measured over 6 dimensions; a dimension has no fields of its own, only sub-dimension-name keys.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "$ref": "#/$defs/SubDimension"
  },
  "$defs": {
    "Implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "name"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "description": {
          "type": "string"
        },
        "test-url-expects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "References": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samm2",
        "iso27001-2022",
        "openCRE"
      ],
      "properties": {
        "samm2": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "iso27001-2017": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "iso27001-2022": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "openCRE": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          }
        },
        "d3f": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "time",
        "resources"
      ],
      "properties": {
        "knowledge": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "time": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "resources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "Activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "risk",
        "measure",
        "difficultyOfImplementation",
        "usefulness",
        "level",
        "tags",
        "references"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(-[a-z]+)?$"
        },
        "description": {
          "type": "string"
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "measure": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "assessment": {
          "type": "string"
        },
        "difficultyOfImplementation": {
          "$ref": "#/$defs/Difficulty"
        },
        "usefulness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "implementation": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Implementation"
              }
            },
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 0
            }
          ]
        },
        "references": {
          "$ref": "#/$defs/References"
        },
        "comments": {
          "type": [
            "string",
            "null"
          ]
        },
        "comment": {
          "type": "string"
        },
        "credits": {
          "type": "string"
        }
      }
    },
    "SubDimension": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/Activity"
      }
    }
  }
}
