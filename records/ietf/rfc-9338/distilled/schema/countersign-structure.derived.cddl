; =====================================================================
; countersign-structure.derived.cddl
;
; DERIVED -- not verbatim.  Written by this library.  RFC 9338's own CDDL
; is in rfc9338.cddl and its exact source renderings are in
; source-renderings.txt; read one of those before citing a grammar as the
; standard's.
;
; WHAT WAS CHANGED, and nothing else was:
;
;   1. ERRATUM 7338 APPLIED.  The trailing `/` after
;      "CounterSignature0V2" in RFC 9338 section 3.3 is removed, so this
;      file parses.  The erratum is Reported, not Verified.
;   2. THE RFC 9052 IMPORTS ARE SUPPLIED.  RFC 9338's collected CDDL
;      references COSE_Signature and empty_or_serialized_map without
;      defining them.  They are reproduced here from this library's
;      verbatim capture of RFC 9052's CDDL
;      (records/ietf/rfc-9052/distilled/schema/cose.cddl) and are marked
;      IMPORTED below.  Their text is RFC 9052's; their presence in this
;      file is ours.
;   3. DEDENTED.  The RFC's ten-space sourcecode indent is removed.
;
; WHAT WAS NOT CHANGED.  No rule is renamed, reordered within a fragment,
; retyped or tightened.  In particular `payload : bstr` is left MANDATORY,
; as RFC 9338 prints it, although four of the eight permitted target
; structures have no payload field and section 3.3's prose does not say
; what fills the slot for them.  That under-specification is a finding, not
; a defect to patch: see README.md and ../design-notes.md section 3.
; =====================================================================

; ---- RFC 9338 section 1.2 -- the initial non-terminal ----
start = COSE_Countersignature_Tagged / Internal_Types

; This is defined to make the tool quieter:
Internal_Types = Countersign_structure / COSE_Countersignature0

; ---- RFC 9338 section 2 -- the two header parameters ----
CountersignatureV2_header = (
    ? 11 => COSE_Countersignature / [+ COSE_Countersignature]
)

Countersignature0V2_header = (
    ? 12 => COSE_Countersignature0
)

; ---- RFC 9338 section 3.1 -- the full countersignature ----
COSE_Countersignature_Tagged = #6.19(COSE_Countersignature)
COSE_Countersignature = COSE_Signature

; ---- RFC 9338 section 3.2 -- the abbreviated countersignature ----
COSE_Countersignature0 = bstr

; ---- RFC 9338 section 3.3 -- the to-be-signed structure ----
; ERRATUM 7338 APPLIED: the trailing `/` after "CounterSignature0V2" is
; removed.  Everything else is as printed.
Countersign_structure = [
  context : "CounterSignature" / "CounterSignature0" /
            "CounterSignatureV2" / "CounterSignature0V2",
  body_protected : empty_or_serialized_map,
  ? sign_protected : empty_or_serialized_map,
  external_aad : bstr,
  payload : bstr,
  ? other_fields : [+ bstr ]
]

; ---- IMPORTED from RFC 9052, not defined by RFC 9338 ----
; Text copied from records/ietf/rfc-9052/distilled/schema/cose.cddl, which
; is this library's verbatim capture of RFC 9052's grammar.  Supplied here
; only so that this file resolves; RFC 9338 defines neither.
COSE_Signature =  [
    Headers,
    signature : bstr
]

Headers = (
    protected : empty_or_serialized_map,
    unprotected : header_map
)

header_map = {
    Generic_Headers,
    * label => values
}

empty_or_serialized_map = bstr .cbor header_map / bstr .size 0

Generic_Headers = (
    ? 1 => int / tstr,  ; algorithm identifier
    ? 2 => [+label],    ; criticality
    ? 3 => tstr / int,  ; content type
    ? 4 => bstr,        ; key identifier
    ? ( 5 => bstr //    ; IV
        6 => bstr )     ; Partial IV
)

label = int / tstr
values = any
