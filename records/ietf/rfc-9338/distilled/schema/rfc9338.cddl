; Source   .cache/rfc-9338.txt
; Digest   sha256:3fd3a4b1cb4060070ffcf6104de0c12c6c5bed6cf2329d9019a16f7717365dde
; Cut      5 fragments, 8 rules, in the document's own order
;          (RFC 9338 section 1.2 requires `start` to come first)
;
; ERRATUM 7338 IS PRESENT IN THE section 3.3 FRAGMENT BELOW AND IS NOT
; REPAIRED.  Reported, Technical, section 3.3, Carsten Bormann,
; 2023-02-06; errata searched 2026-10-20 and it is the only erratum on
; RFC 9338.  The `context` choice ends with a trailing `/` before the
; comma, a choice operator with no right operand, so THIS FILE DOES NOT
; PARSE.  RFC 8610 Appendix B: `type = type1 *(S "/" S type1)`.
;
; THIS FILE IS ALSO NOT SELF-CONTAINED, which no erratum covers: the
; collected CDDL that RFC 9338 section 1.2's XPath expression yields
; references two names it does not define, COSE_Signature and
; empty_or_serialized_map, both from RFC 9052.  README.md has the census.
; =====================================================================

; §1.2 -- start, Internal_Types
; lines 165-168 · sha256:38ef4987118e6098a22205ea9c475a04e9bc9c3396ec6bce8c3d8a94cbde42fb
         start = COSE_Countersignature_Tagged / Internal_Types

         ; This is defined to make the tool quieter:
         Internal_Types = Countersign_structure / COSE_Countersignature0

; §2 -- CountersignatureV2_header, Countersignature0V2_header
; lines 235-241 · sha256:b9d5444f89197c8194e3c3cb841152f3f2264e80b80509bbc454d252838e0a79
         CountersignatureV2_header = (
             ? 11 => COSE_Countersignature / [+ COSE_Countersignature]
         )

         Countersignature0V2_header = (
             ? 12 => COSE_Countersignature0
         )

; §3.1 -- COSE_Countersignature_Tagged, COSE_Countersignature
; lines 319-320 · sha256:0dfedee5f8f53de4108a44ffe33fa0e38aa8c6f2e8992a795f2d6d81ffc12245
         COSE_Countersignature_Tagged = #6.19(COSE_Countersignature)
         COSE_Countersignature = COSE_Signature

; §3.2 -- COSE_Countersignature0
; lines 348-348 · sha256:95ca076b0e373845e32bcc1350bb140bd9ca23634b897a8e1f8511b882c2083e
         COSE_Countersignature0 = bstr

; §3.3 -- Countersign_structure
; lines 407-415 · sha256:564876cf1fa22e09b86aab53981b7d7121f20fc8f6f53aebf72ffeab08018b88
         Countersign_structure = [
           context : "CounterSignature" / "CounterSignature0" /
                     "CounterSignatureV2" / "CounterSignature0V2" /,
           body_protected : empty_or_serialized_map,
           ? sign_protected : empty_or_serialized_map,
           external_aad : bstr,
           payload : bstr,
           ? other_fields : [+ bstr ]
         ]

