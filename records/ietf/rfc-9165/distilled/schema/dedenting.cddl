; =====================================================================
; dedenting.cddl
;
; VERBATIM.  RFC 9165's own CDDL, copied unchanged, margin intact.  NOT
; authored by this project.
;
; Figure 3 (Section 2.3) - .abnfb over a .det-composed controller.  Held in
; its own file because Figure 4, its stated result, REDEFINES the rule name
; `oid`; the two cannot share a file.  Same reason rfc-8610 keeps
; reputon-verbose.cddl and reputon-compact.cddl apart.
;
; Source digest (sha256 of the full cached source text):
;   94f86116c04fde0f11d54576465181090ec33983d78db82527c0703a41976774
; Source: RFC 9165, "Additional Control Operators for the Concise
;         Data Definition Language (CDDL)", C. Bormann, December
;         2021, Standards Track, ISSN 2070-1721.
;         <https://www.rfc-editor.org/rfc/rfc9165.txt>
; =====================================================================

; Figure 3: An Example of Dedenting Concatenation
; ---- BEGIN VERBATIM F-3 (source lines 207-215, sha256 8a4cc2c9d1f5c455db2de2cbea08890a6ee585742c03efc61a43085fcc9d6bda) ----
   oid = bytes .abnfb ("oid" .det cbor-tags-oid)
   roid = bytes .abnfb ("roid" .det cbor-tags-oid)

   cbor-tags-oid = '
     oid = 1*arc
     roid = *arc
     arc = [nlsb] %x00-7f
     nlsb = %x81-ff *%x80-ff
   '
; ---- END VERBATIM F-3 ----
