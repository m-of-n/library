; VERBATIM.  RFC 9165's own CDDL, copied unchanged, with the RFC's
; three-column body margin intact.  NOT authored by this project.  Do not
; edit, correct or reformat it; defects are recorded in README.md.
;
; Figures 1 and 2 - the worked examples for .plus (Section 2.1) and .cat
; (Section 2.2).  Figure captions are not part of the CDDL and are not
; captured here; they are in ../normative.md, which reproduces each figure
; with its caption.
;
; Source digest (sha256 of the full cached source text):
;   94f86116c04fde0f11d54576465181090ec33983d78db82527c0703a41976774
; Source: RFC 9165, "Additional Control Operators for the Concise
;         Data Definition Language (CDDL)", C. Bormann, December
;         2021, Standards Track, ISSN 2070-1721.
;         <https://www.rfc-editor.org/rfc/rfc9165.txt>
; =====================================================================

; Figure 1: An Example of Addition to a Base Value
; ---- BEGIN VERBATIM F-1 (source lines 148-159, sha256 1b7da5b0dc2db4f5d0a4aa97672a548f2ecd109e85302e2292e3e8776c4a14a1) ----
   interval<BASE> = (
     BASE => int             ; lower bound
     (BASE .plus 1) => int   ; upper bound
     ? (BASE .plus 2) => int ; tolerance
   )

   X = 0
   Y = 3
   rect = {
     interval<X>
     interval<Y>
   }
; ---- END VERBATIM F-1 ----

; Figure 2: An Example of Concatenation of Text and Byte Strings.
; The `;` line is the source's own comment and is part of the figure.
; ---- BEGIN VERBATIM F-2 (source lines 184-189, sha256 8808cb9f4c5be7476927f870ea66f392c513bb478bb75ca2365b0e9743c339ea) ----
   c = "foo" .cat '
     bar
     baz
   '
   ; on a system where the newline is \n, is the same string as:
   b = "foo\n  bar\n  baz\n"
; ---- END VERBATIM F-2 ----
