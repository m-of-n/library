; =====================================================================
; abnf-in-cddl.cddl
;
; VERBATIM.  RFC 9165's own CDDL, copied unchanged, margin intact.  NOT
; authored by this project.
;
; Figure 5 (Section 3) - the document's only full worked example, and the only
; place it shows all of .abnf, .cat and .det composing.  It defines CBOR tag
; 1004 (RFC 8943) and CBOR tag 0 (RFC 8949) by embedding RFC 3339's ABNF.
; The ABNF inside the two byte-string literals is held separately as regions
; A-3 and A-4 of embedded-abnf.abnf, and in evaluated form as D-3 of
; embedded-abnf-dedented.derived.abnf.
;
; Source digest (sha256 of the full cached source text):
;   94f86116c04fde0f11d54576465181090ec33983d78db82527c0703a41976774
; Source: RFC 9165, "Additional Control Operators for the Concise
;         Data Definition Language (CDDL)", C. Bormann, December
;         2021, Standards Track, ISSN 2070-1721.
;         <https://www.rfc-editor.org/rfc/rfc9165.txt>
; =====================================================================

; Figure 5: An Example of Employing ABNF from RFC 3339 for
; Defining CBOR Tags
; ---- BEGIN VERBATIM F-5 (source lines 312-346, sha256 96884387ef2b61aeaee82af93a3c1deded363175f10cb304a0866c3be75f38f3) ----
   ; for RFC 8943
   Tag1004 = #6.1004(text .abnf full-date)
   ; for RFC 8949
   Tag0 = #6.0(text .abnf date-time)

   full-date = "full-date" .cat rfc3339
   date-time = "date-time" .cat rfc3339

   ; Note the trick of idiomatically starting with a newline, separating
   ;   off the element in the concatenations above from the rule-list
   rfc3339 = '
      date-fullyear   = 4DIGIT
      date-month      = 2DIGIT  ; 01-12
      date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on
                                ; month/year
      time-hour       = 2DIGIT  ; 00-23
      time-minute     = 2DIGIT  ; 00-59
      time-second     = 2DIGIT  ; 00-58, 00-59, 00-60 based on leap sec
                                ; rules
      time-secfrac    = "." 1*DIGIT
      time-numoffset  = ("+" / "-") time-hour ":" time-minute
      time-offset     = "Z" / time-numoffset

      partial-time    = time-hour ":" time-minute ":" time-second
                        [time-secfrac]
      full-date       = date-fullyear "-" date-month "-" date-mday
      full-time       = partial-time time-offset

      date-time       = full-date "T" full-time
   ' .det rfc5234-core

   rfc5234-core = '
      DIGIT          =  %x30-39 ; 0-9
      ; abbreviated here
   '
; ---- END VERBATIM F-5 ----
