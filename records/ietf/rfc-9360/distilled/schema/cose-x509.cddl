;   3dbe546adf08e309b429c8e71b2ee8384292fb8767338d3eb17d1c4e5adefc23
;
; THESE TWO LINES ARE THE WHOLE WIRE FORMAT OF RFC 9360.  Everything
; else the document specifies is a label, a registry action or prose.
;
; Checked for this pass against RFC 8610 Appendix B's grammar (this
; library holds it verbatim at records/ietf/rfc-8610/distilled/schema/
; cddl.abnf): BOTH RULES PARSE AS PRINTED, as type rules, with the
; indentation intact - CDDL whitespace is free-form (`S = *WS`), unlike
; ABNF's.  See cddl-parse.derived.txt.
;
; Carried over from the source and NOT fixed here: `certs`, `hashAlg`
; and `hashValue` are bareword MEMBER KEYS (`memberkey = bareword S
; ":"`), not type references, so nothing in this file is an undefined
; name.  And the sentence that gives `bstr` its meaning is NOT in the
; CDDL - it is the prose line 314, carried in source-renderings.txt.
; =====================================================================

   COSE_X509 = bstr / [ 2*certs: bstr ]
   COSE_CertHash = [ hashAlg: (int / tstr), hashValue: bstr ]
