; =====================================================================
; module-directives-dedented.derived.abnf
;
; DERIVED - not verbatim.  This is module-directives.abnf with the
; Internet-Draft's three-column left margin removed and NOTHING else
; changed: same lines, same order, same interior spacing, same
; continuation lines.  Cite module-directives.abnf, never this file.
;
; Why it exists: RFC 5234 reads an indented line as a continuation of the
; preceding rule, so the margin-bearing capture collapses into a single
; `directive` rule and no ABNF tool can use it.  Same reason as
; records/ietf/rfc-8610/distilled/schema/cddl-dedented.derived.abnf.
;
; Transformation: remove the common left indent (3 columns) from every
; non-blank line.  Round-trip checked in both directions against the
; cached source at generation time.
;
; Source: draft-ietf-cbor-cddl-modules-07, Appendix A, source lines 677-688.
; Full-source sha256:
;   7cf825aaad43d3d4995bcd540d3865ee3f69dd3dd453be5761a02c009458a644
; Verbatim-region sha256: 43c17148af31265a171f2e722b24d2e0063d0ab253d8b681cc1c223d5df696ab
; This file's grammar-body sha256 (the 12 lines below, no header):
;   520099c02bbd1d617e188777a04747dc1cb4f032b77bd97365306747f12c149e
;
; The two continuation lines (`directive`'s second line and `id`'s second
; line) keep their relative indent, which is what makes them
; continuations under RFC 5234.  That is deliberate and is the only
; indentation this file still carries.
; =====================================================================

directive = ";#" RS (%s"import" / %s"include") RS [from-clause]
                    filename [as-clause] CRLF
from-clause = 1*(id-or-all [","] RS) %s"from" RS
as-clause = RS %s"as" RS id
filename = 1*("-" / "." / %x30-39 / %x41-5a / "_" / %x61-7a)
id = ("$" / %x40-5a / "_" / %x61-7a)
     *("$" / %x30-39 / %x40-5a / "_" / %x61-7a)
id-or-all = id / "*"
RS = 1*WS
WS = SP
SP = %x20
CRLF = %x0A / %x0D.0A
