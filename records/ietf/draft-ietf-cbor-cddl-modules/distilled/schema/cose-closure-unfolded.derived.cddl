; =====================================================================
; cose-closure-unfolded.derived.cddl
;
; DERIVED - not verbatim.  The two composed basic-CDDL outputs that
; draft-ietf-cbor-cddl-modules-07 Section 2.6 prints are the ONLY two
; blocks in the document that carry an RFC 8792 '\' line wrap, so they
; are the only two that cannot be used as CDDL as printed.  This file is
; those two blocks with the wrap undone and NOTHING else changed.
;
; Cite examples/vectors.yaml (V-0011, V-0013), which carry the source's
; own folded bytes.  Never cite this file as the document's text.
;
; Transformation, mechanical, per RFC 8792's single-backslash strategy as
; the document's own banner invokes it ("=============== NOTE: '\' line
; wrapping per RFC 8792 ================", source lines 418 and 453):
; remove the trailing "\", the line break, and the leading whitespace of
; the continuation line.  It fires exactly once in each block, on
; `cose.empty_or_serialized_map`.  The common left margin is also
; removed, as everywhere in this record.
;
; Source: draft-ietf-cbor-cddl-modules-07, Section 2.6, lines 420-435 and
; 455-471.  Full-source sha256:
;   7cf825aaad43d3d4995bcd540d3865ee3f69dd3dd453be5761a02c009458a644
; This file's body sha256 (everything below this header):
;   9ec0566cf05ad21ecc551c0d4702bce6b5b28cf791ff148fb84e40f278a2d09c
;
; NOT a COSE schema.  These are the document's own illustrations of what
; `import ... from rfc9052 as cose` emits, drawn from the cddlc tool's
; bundled extract of RFC 9052 rather than from RFC 9052 itself.  Every
; inline comment RFC 9052 writes on these rules (`; kty`, `; kid`,
; `; alg`, `; criticality`, ...) is absent, because no output this
; document prints contains a comment of any kind.  See README.md,
; "What the composed outputs show that the prose does not".
; =====================================================================

; §2.6 ("import"), the transitive-closure output.  Source lines 420-435,
; under the banner at line 418.  Entry rule: mydata.
mydata = {Fritz: cose.empty_or_serialized_map}
cose.empty_or_serialized_map = bstr .cbor cose.header_map / bstr .size 0
cose.header_map = {
  cose.Generic_Headers,
  * cose.label => cose.values,
}
cose.Generic_Headers = (
  ? 1 => int / tstr,
  ? 2 => [+ cose.label],
  ? 3 => tstr / int,
  ? 4 => bstr,
  ? (5 => bstr // 6 => bstr),
  )
cose.label = int / tstr
cose.values = any

; §2.6 ("import"), the alias output: the same closure with the extra
; unprefixed alias rule the source points out.  Source lines 455-471,
; under the banner at line 453.  Entry rule: mydata.  This model
; redefines nothing from the block above, but it defines mydata a second
; time, so the two blocks are SEPARATE models and must not be
; concatenated.
mydata = {Fritz: cose.empty_or_serialized_map}
empty_or_serialized_map = cose.empty_or_serialized_map
cose.empty_or_serialized_map = bstr .cbor cose.header_map / bstr .size 0
cose.header_map = {
  cose.Generic_Headers,
  * cose.label => cose.values,
}
cose.Generic_Headers = (
  ? 1 => int / tstr,
  ? 2 => [+ cose.label],
  ? 3 => tstr / int,
  ? 4 => bstr,
  ? (5 => bstr // 6 => bstr),
  )
cose.label = int / tstr
cose.values = any
