; =====================================================================
; prelude.cddl
;
; VERBATIM.  This is RFC 8610's own standard prelude, copied unchanged.
; It was NOT authored by this project.  Do not edit it, do not correct
; it, do not reformat it.  Defects found in it are recorded in
; README.md, never repaired here.
;
; Locator:  RFC 8610, Appendix D, "Standard Prelude" (Figure 14: CDDL
;           Prelude).  Source text lines 2876-2931.
;           <https://www.rfc-editor.org/rfc/rfc8610.txt>
;
; Source digest (sha256 of the full cached source text):
;   3713f2a50e23a2bea0a6147ad6c4433605a00c3d00a868bfa86a42b204997089
;
; Appendix D is NORMATIVE.  Its own preamble, quoted:
;
;      This appendix is normative.
;
;      The following prelude is automatically added to each CDDL file.
;      (Note that technically, it is a postlude, as it does not disturb the
;      selection of the first rule as the root of the definition.)
;
; and its closing notes, quoted (source lines 2935-2943):
;
;      Note that the prelude is deemed to be fixed.  This means, for
;      instance, that additional tags beyond those defined in [RFC7049], as
;      registered, need to be defined in each CDDL file that is using them.
;
;      A common stumbling point is that the prelude does not define a type
;      "string".  CBOR has byte strings ("bytes" in the prelude) and text
;      strings ("text"), so a type that is simply called "string" would be
;      ambiguous.
;
; The RFC's eighteen-column left margin is preserved.  Unlike the ABNF,
; this costs nothing: CDDL whitespace is free-form (S = *WS), so the file
; is valid CDDL as it stands.
;
; The prelude crosses one RFC page frame (52->53) and is therefore
; reproduced as two contiguous regions.  Concatenated in order they are
; the whole of Figure 14: 40 rules, any through undefined.  Every name on
; a right-hand side resolves inside the prelude (e10, e2 and m in decfrac
; and bigfloat are member keys, not rule references).
; =====================================================================

; ---- BEGIN VERBATIM D-1 (source lines 2876-2906, sha256 7b7543ac3d763d12d5308af8a72144a1d34ff089ff7b5eba406b382e6750df22) ----
                  any = #

                  uint = #0
                  nint = #1
                  int = uint / nint

                  bstr = #2
                  bytes = bstr
                  tstr = #3
                  text = tstr

                  tdate = #6.0(tstr)
                  time = #6.1(number)
                  number = int / float
                  biguint = #6.2(bstr)
                  bignint = #6.3(bstr)
                  bigint = biguint / bignint
                  integer = int / bigint
                  unsigned = uint / biguint
                  decfrac = #6.4([e10: int, m: integer])
                  bigfloat = #6.5([e2: int, m: integer])
                  eb64url = #6.21(any)
                  eb64legacy = #6.22(any)
                  eb16 = #6.23(any)
                  encoded-cbor = #6.24(bstr)
                  uri = #6.32(tstr)
                  b64url = #6.33(tstr)
                  b64legacy = #6.34(tstr)
                  regexp = #6.35(tstr)
                  mime-message = #6.36(tstr)
                  cbor-any = #6.55799(any)
; ---- END VERBATIM D-1 ----

; ---- BEGIN VERBATIM D-2 (source lines 2919-2931, sha256 1fdf43ef209a952d92a958a4369f03234c404d1ec3fe4d35e5593eb158cb09c0) ----
                  float16 = #7.25
                  float32 = #7.26
                  float64 = #7.27
                  float16-32 = float16 / float32
                  float32-64 = float32 / float64
                  float = float16-32 / float64

                  false = #7.20
                  true = #7.21
                  bool = false / true
                  nil = #7.22
                  null = nil
                  undefined = #7.23
; ---- END VERBATIM D-2 ----
