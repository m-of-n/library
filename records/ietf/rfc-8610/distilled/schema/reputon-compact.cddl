; =====================================================================
; reputon-compact.cddl
;
; VERBATIM.  RFC 8610's own bytes, copied unchanged.  NOT authored by
; this project.  Do not edit, correct or reformat it.
;
; Locator:  RFC 8610, Appendix H -- "An equivalent, more compact form
;           of this example".  Source text lines 3380-3396.
;           <https://www.rfc-editor.org/rfc/rfc8610.txt>
;
; Source digest (sha256 of the full cached source text):
;   3713f2a50e23a2bea0a6147ad6c4433605a00c3d00a868bfa86a42b204997089
;
; APPENDIX H IS FOR INFORMATION ONLY.  Equivalent to
; reputon-verbose.cddl.  Note what it demonstrates in passing: group
; entries here carry NO separating commas at all (optcom makes the
; comma decoration, not syntax), and the single `* text => any` line
; replaces the named ext-value group.
; =====================================================================

; ---- BEGIN VERBATIM H-3 (source lines 3380-3396, sha256 9a3f4a4817e0e0513b707791a55872bc5ce3cc6428975f8d409d9669d7763f87) ----
                        reputation-object = {
                          application: text
                          reputons: [* reputon]
                        }

                        reputon = {
                          rater: text
                          assertion: text
                          rated: text
                          rating: float16
                          ? confidence: float16
                          ? normal-rating: float16
                          ? sample-size: uint
                          ? generated: uint
                          ? expires: uint
                          * text => any
                        }
; ---- END VERBATIM H-3 ----
