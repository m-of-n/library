; =====================================================================
; reputon-verbose.cddl
;
; VERBATIM.  RFC 8610's own bytes, copied unchanged.  NOT authored by
; this project.  Do not edit, correct or reformat it.
;
; Locator:  RFC 8610, Appendix H, "Examples" -- the "(somewhat
;           verbose) equivalent definition" of the [RFC7071] reputon
;           structure.  Source text lines 3330-3376.
;           <https://www.rfc-editor.org/rfc/rfc8610.txt>
;
; Source digest (sha256 of the full cached source text):
;   3713f2a50e23a2bea0a6147ad6c4433605a00c3d00a868bfa86a42b204997089
;
; APPENDIX H IS FOR INFORMATION ONLY -- the appendix says so itself.
; This is an example of CDDL, not a normative schema, and it describes
; an RFC 7071 JSON structure, not anything of ours.  It is held here
; because it is the document's one worked end-to-end example: a schema
; of real size with a matching instance (examples/vectors.yaml).
;
; The example crosses one page frame (60->61) and is reproduced as two
; contiguous regions.  reputon-compact.cddl holds the equivalent
; compact form; the two are separate files because they redefine the
; same rule names and so cannot share one CDDL file.
; =====================================================================

; ---- BEGIN VERBATIM H-1 (source lines 3330-3356, sha256 5bcb0261619227563183d74454a6cbf45d3b8c2e28051bf70532bf2915e5a2e8) ----
                 reputation-object = {
                   reputation-context,
                   reputon-list
                 }

                 reputation-context = (
                   application: text
                 )

                 reputon-list = (
                   reputons: reputon-array
                 )

                 reputon-array = [* reputon]

                 reputon = {
                   rater-value,
                   assertion-value,
                   rated-value,
                   rating-value,
                   ? conf-value,
                   ? normal-value,
                   ? sample-value,
                   ? gen-value,
                   ? expire-value,
                   * ext-value,
                 }
; ---- END VERBATIM H-1 ----

; ---- BEGIN VERBATIM H-2 (source lines 3367-3376, sha256 5ce5e066099b81359a30ee84801c764a5b284bde0f5958f6b4da2fd4394fde9c) ----
                 rater-value = ( rater: text )
                 assertion-value = ( assertion: text )
                 rated-value = ( rated: text )
                 rating-value = ( rating: float16 )
                 conf-value = ( confidence: float16 )
                 normal-value = ( normal-rating: float16 )
                 sample-value = ( sample-size: uint )
                 gen-value = ( generated: uint )
                 expire-value = ( expires: uint )
                 ext-value = ( text => any )
; ---- END VERBATIM H-2 ----
