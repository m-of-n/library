; =====================================================================
; prelude-json-subset.cddl
;
; VERBATIM.  RFC 8610's own bytes, copied unchanged.  NOT authored by
; this project.  Do not edit, correct or reformat it.
;
; Locator:  RFC 8610, Appendix E, "Use with JSON" (Figure 15:
;           JSON-Compatible Subset of CDDL Prelude).  Source text lines
;           2975-2997.  <https://www.rfc-editor.org/rfc/rfc8610.txt>
;
; Source digest (sha256 of the full cached source text):
;   3713f2a50e23a2bea0a6147ad6c4433605a00c3d00a868bfa86a42b204997089
;
; Appendix E is NORMATIVE.  This is the prelude "limited" to what the
; JSON generic data model can carry: byte strings, tags and simple
; values other than false/true/null are left out.  It is a SUBSET of
; prelude.cddl, not a replacement for it -- the prelude is still the
; prelude; this figure says which of its names survive in JSON.
;
; The figure's own trailing note, quoted (source lines 3001-3003):
;
;      (The major types given here do not have a direct meaning in JSON, but
;      they can be interpreted as CBOR major types translated through
;      Section 4 of [RFC7049].)
; =====================================================================

; ---- BEGIN VERBATIM E-15 (source lines 2975-2997, sha256 aab9385c6f2cceefd28d3f55ad4dc7a13e3c8087dfc19545c44459587cbb70df) ----
                      any = #

                      uint = #0
                      nint = #1
                      int = uint / nint

                      tstr = #3
                      text = tstr

                      number = int / float

                      float16 = #7.25
                      float32 = #7.26
                      float64 = #7.27
                      float16-32 = float16 / float32
                      float32-64 = float32 / float64
                      float = float16-32 / float64

                      false = #7.20
                      true = #7.21
                      bool = false / true
                      nil = #7.22
                      null = nil
; ---- END VERBATIM E-15 ----
