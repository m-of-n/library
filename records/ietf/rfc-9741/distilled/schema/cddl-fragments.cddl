; =====================================================================
; cddl-fragments.cddl
;
; VERBATIM -- these are RFC 9741's own bytes. Every region below is the
; cached source lifted by line range, with the RFC's LEFT MARGIN INTACT,
; so this file is NOT parseable as CDDL: the margin is part of what is
; being preserved. The tool-readable companion is
; cddl-fragments-dedented.derived.cddl, which is derived and says so.
;
; Only the "; ---" region banners and this header are ours. Remove every
; line beginning with ";" and what is left is byte-identical to the
; corresponding source lines.
;
; Source: RFC 9741, cached source sha256
;   3234aeea39d01b7c1c8e9c70d4d7dc8745852e0b6edbea167a3e55b91e7a9ee3
; =====================================================================

; --- F01  §2.1  base64url over a CBOR-encoded COSE_Sign1
;     source lines 159-160   region sha256 c2f514ac5defcdda14fa305723516b0e731282b71320e4492ff166c1c5431f74
   signature-for-json = text .b64u signature
   signature = bytes .cbor COSE_Sign1

; --- F02  §2.2  a YANG-JSON SID as decimal text
;     source lines 248-248   region sha256 861f2c2524ef6e1c99c2dc0e12d91be7596c7263862cf1433d6bdd00d5b30ce0
   yang-json-sid = text .base10 (0..9223372036854775807)

; --- F03  §2.3  a fixed hex label, via a generic
;     source lines 299-300   region sha256 3db6297143bbeb8a1b0d5844bb079f1ee83863bf612047783185b27936e61e07
   my_alg_19 = hexlabel<19>
   hexlabel<K> = text .printf (["0x%04x", K])

; --- F04  §2.3  a hex label over a range
;     source lines 305-306   region sha256 478a82cf93be1d6def7f67046fa523f952154b0ce9366dbc788cc967685ce2c6
   any_alg = hexlabel<1..20>
   hexlabel<K> = text .printf (["0x%04x", K])

; --- F05  §2.4  JWT-style claims embedded as a JSON text
;     source lines 329-330   region sha256 08acb1de19120da067db5762a6ef3505ae753718deb2a693357a06c95a7956cf
   embedded-claims = text .json claims
   claims = {iss: text, exp: text}

; --- F06  §3.1 (Figure 1)  dotted-decimal IPv4, built by .join
;     source lines 377-384   region sha256 4ae798f91b6e6bb236fac1ec25e468e327c55039844a0ade2a7026f53d6a69f5
   legacy-ip-address = text .join legacy-ip-address-elements
   legacy-ip-address-elements = [bytetext, ".", bytetext, ".",
                                 bytetext, ".", bytetext]
   bytetext = text .base10 byte
   byte = 0..255

      Figure 1: Using the .join Operator to Build Dotted-Decimal IPv4
                                 Addresses
