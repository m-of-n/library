; =====================================================================
; cddl-fragments-dedented.derived.cddl
;
; DERIVED -- NOT verbatim. This is cddl-fragments.cddl with the RFC's
; three-space left margin removed so that a CDDL tool can read it. The
; text inside each region is otherwise untouched, and the removal
; round-trips: re-indenting every non-blank line by three spaces
; reproduces the verbatim file's regions exactly.
;
; DO NOT CONCATENATE THE REGIONS. F03 and F04 each define hexlabel<K>,
; identically; a naive concatenation is a CDDL file with a duplicate rule
; name, which RFC 8610 Appendix C makes an error only when the second
; definition differs. Treat each region as its own file; that is how
; examples/vectors.yaml carries them.
;
; Figure 1's caption (source lines 383-384) is kept in the verbatim file
; and dropped here, because it is not CDDL.
;
; Source: RFC 9741, cached source sha256
;   3234aeea39d01b7c1c8e9c70d4d7dc8745852e0b6edbea167a3e55b91e7a9ee3
; =====================================================================

; --- F01  §2.1  base64url over a CBOR-encoded COSE_Sign1   (source lines 159-160)
signature-for-json = text .b64u signature
signature = bytes .cbor COSE_Sign1

; --- F02  §2.2  a YANG-JSON SID as decimal text   (source lines 248-248)
yang-json-sid = text .base10 (0..9223372036854775807)

; --- F03  §2.3  a fixed hex label, via a generic   (source lines 299-300)
my_alg_19 = hexlabel<19>
hexlabel<K> = text .printf (["0x%04x", K])

; --- F04  §2.3  a hex label over a range   (source lines 305-306)
any_alg = hexlabel<1..20>
hexlabel<K> = text .printf (["0x%04x", K])

; --- F05  §2.4  JWT-style claims embedded as a JSON text   (source lines 329-330)
embedded-claims = text .json claims
claims = {iss: text, exp: text}

; --- F06  §3.1 (Figure 1)  dotted-decimal IPv4, built by .join   (source lines 377-381)
legacy-ip-address = text .join legacy-ip-address-elements
legacy-ip-address-elements = [bytetext, ".", bytetext, ".",
                              bytetext, ".", bytetext]
bytetext = text .base10 byte
byte = 0..255
