; RFC 9943 (SCITT Architecture) — Section 6.1, "Signed Statement Examples"
; Figure 3: "CDDL Definition for Signed Statements and Receipts"
; Source: rfc9943.txt lines 931-963; figure caption at line 965.
; The RFC calls this a "normative CDDL definition [RFC8610]".
;
; Copied VERBATIM, including the RFC's three-column left margin and the
; two spaces before "=>" on the `receipts` entry. Nothing added, removed,
; reordered, or realigned. CDDL ignores leading whitespace, so the retained
; margin does not affect parsing.
;
; COSE_CertHash and COSE_X509 are referenced but NOT defined in this RFC's
; CDDL and there is no CDDL import; they originate in RFC 9360, which the
; RFC cites only in prose (Section 5.1.1.1). See README.md.

   Signed_Statement = #6.18(COSE_Sign1)
   Receipt = #6.18(COSE_Sign1)

   COSE_Sign1 = [
     protected   : bstr .cbor Protected_Header,
     unprotected : Unprotected_Header,
     payload     : bstr / nil,
     signature   : bstr
   ]

   Protected_Header = {
     &(CWT_Claims: 15) => CWT_Claims
     ? &(alg: 1) => int
     ? &(content_type: 3) => tstr / uint
     ? &(kid: 4) => bstr
     ? &(x5t: 34) => COSE_CertHash
     ? &(x5chain: 33) => COSE_X509
     * label => any
   }

   CWT_Claims = {
     &(iss: 1) => tstr
     &(sub: 2) => tstr
     * label => any
   }

   Unprotected_Header = {
     ? &(x5chain: 33) => COSE_X509
     ? &(receipts: 394)  => [+ bstr .cbor Receipt]
     * label => any
   }

   label = int / tstr
