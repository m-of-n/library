; =====================================================================
; advanced-transport.abnf
;
; VERBATIM -- this is RFC 9804's own grammar, copied unchanged.
; It was NOT authored by this project. Do not edit it, do not correct
; it, do not reformat it. Defects found in it are recorded in
; README.md, never repaired here.
;
; Locator:  RFC 9804, "Simple Public Key Infrastructure (SPKI)
;           S-Expressions", Rivest & Eastlake, June 2025,
;           Informational, ISSN 2070-1721.
;           Section 7.1, "ABNF for Advanced Transport".
;           Source text lines 716-773.
;           <https://www.rfc-editor.org/rfc/rfc9804.txt>
;
; Source digest (sha256 of the full source text):
;   0db36cc4bb9d0e08c4999ab775c955daec0f62e849bbfe688e223998d5a44434
;
; Verbatim region digest (sha256 of the bytes between the BEGIN and END
; markers below, markers excluded):
;   622fe32711d9a13950ec4e82c49a1fc526c4281ddbe39253cdf9a0d9648c3f46
;
; The region preserves the RFC's three-space left margin, its
; continuation-line alignment, its inline ";" comments and its internal
; blank lines. Byte-exactness was confirmed by diffing the extracted
; region against the source lines, not by reading.
;
; The BEGIN/END markers are written as ABNF comments so that this file
; remains machine-checkable as ABNF (RFC 5234).
;
; Rule names in all capitals are the core rules of RFC 5234
; Appendix B.1 and are not reproduced here; RFC 9804 Section 7 says so
; explicitly. The nine used below are ALPHA, CR, DQUOTE, HEXDIG, HTAB,
; LF, OCTET, SP and the decimal-digit core rule.
;
; This grammar is closed: every rule it references is either defined
; below or is an RFC 5234 core rule. Sections 7.2 and 7.3 are NOT
; closed -- they import rules from here. See README.md.
; =====================================================================

; ---- BEGIN VERBATIM ----
   sexp           =  *whitespace value *whitespace

   whitespace     =  SP / HTAB / vtab / CR / LF / ff

   vtab           =  %x0B   ; vertical tab

   ff             =  %x0C   ; form feed

   value          =  string / ("(" *(value / whitespace) ")")

   string         =  [display] simple-string

   display        =  "[" *whitespace simple-string *whitespace "]"
                     *whitespace

   simple-string  =  verbatim / quoted-string / token / hexadecimal /
                     base-64

   verbatim       =  decimal ":" *OCTET
                       ; the length followed by a colon and the exact
                       ; number of OCTETs indicated by the length

   decimal        =  %x30 / (%x31-39 *DIGIT)

   quoted-string  =  [decimal] DQUOTE *(printable / escaped) DQUOTE

   printable      =  %x20-21 / %x23-5B / %x5D-7E
                       ; All US-ASCII printable but double-quote and
                       ; backslash

   escaped        =  backslash (%x3F / %x61 / %x62 / %x66 / %x6E /
                     %x72 / %x74 / %x76 / DQUOTE / quote / backslash
                     / 3(%x30-37) / (%x78 2HEXDIG) / CR / LF /
                     (CR LF) / (LF CR))

   backslash      =  %x5C

   quote          =  %x27   ; single quote

   token          =  (ALPHA / simple-punc) *(ALPHA / DIGIT /
                        simple-punc)

   simple-punc    =  "-" / "." / "/" / "_" / ":" / "*" / "+" / "="

   hexadecimal    =  [decimal] "#" *whitespace *hexadecimals "#"

   hexadecimals   =  2(HEXDIG *whitespace)

   base-64        =  [decimal] "|" *whitespace *base-64-chars
                        [base-64-end] "|"

   base-64-chars  =  4(base-64-char *whitespace)

   base-64-char   =  ALPHA / DIGIT / "+" / "/"

   base-64-end    =  base-64-chars /
                     3(base-64-char *whitespace) ["=" *whitespace] /
                     2(base-64-char *whitespace) *2("=" *whitespace)
; ---- END VERBATIM ----
