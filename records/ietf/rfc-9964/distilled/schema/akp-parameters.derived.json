  "deliberate_exclusions": [
    {
      "what": "the expanded ML-DSA private key representation",
      "locator": "section 4",
      "why": "\"this document specifies ML-DSA private key information using only the seed format\"; contrast RFC 9881, which supports the expanded format"
    },
    {
      "what": "HashML-DSA",
      "locator": "section 7.2",
      "why": "\"As the verify routines are different, future support for HashML-DSA would require the registration of additional algorithms.\""
    },
    {
      "what": "a non-empty ctx",
      "locator": "section 5",
      "why": "\"The ctx parameter MUST be the empty string for ML-DSA-44, ML-DSA-65, and ML-DSA-87.\" ctx has no COSE or JOSE label, so the requirement is unobservable from the wire bytes."
    },
    {
      "what": "a crv parameter",
      "locator": "section 3 (by absence)",
      "why": "AKP has none. `pub` is interpreted by `alg` instead - \"The parameters for public and private information classes contain byte strings in a format specified by the alg value.\" This is why `alg` must be in the thumbprint."
    }
  ]
