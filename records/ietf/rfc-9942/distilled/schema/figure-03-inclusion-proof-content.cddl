; -- verbatim extract begins (source line 455) --
   inclusion-proof-content = [

       ; tree size at current Merkle Tree root
       tree-size: uint

       ; index of leaf in tree
       leaf-index: uint

       ; path from leaf to current Merkle Tree root
       inclusion-path: [ + bstr ]
   ]
; -- verbatim extract ends (source line 465) --
