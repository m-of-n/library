; rfc-9921 -- the two COSE header parameters, as CDDL
;
; DERIVED -- not verbatim. RFC 9921 contains NO CDDL (measured: the string
; "CDDL" occurs zero times in its 1056 lines), so every production below is
; this library's rendering of its prose. The filename carries `.derived.`
; as docs/extraction.md requires.
;
; Source of each production is given per rule. RFC 9052's own names
; (header_map, empty_or_serialized_map, label, values, COSE_Sign1,
; COSE_Sign, COSE_Signature) are NAMED AND NOT REDEFINED here; they live in
; records/ietf/rfc-9052/distilled/schema/cose.cddl.
;
; WHAT THIS SCHEMA CANNOT CHECK, stated up front: the contents of the byte
; string. §3.1 and §3.2 both say the value is "a DER-encoded TST [RFC3161]
; wrapped in a CBOR byte string (Major type 2)", and §6 gives Value Registry
; "-". So `bstr` is the whole of the CBOR-side type system for 5453 octets of
; ASN.1, and a CDDL validator that accepts this schema has checked nothing
; about the token. That is the record's central finding, not a gap in this
; file.

; ---------------------------------------------------------------- labels (§6)
; Table 1. Note the inversion: the LOWER label is the protected one.
rfc3161-ttc-label = 269          ; 3161-ttc -- PROTECTED   (§3.2)
rfc3161-ctt-label = 270          ; 3161-ctt -- UNPROTECTED (§3.1)

; ----------------------------------------------------------------- value (§3)
; §3.1 / §3.2: "a DER-encoded TST [RFC3161] wrapped in a CBOR byte string
; (Major type 2)". There is no CBOR-side structure to express: a TST is a CMS
; ContentInfo (RFC 5652) carrying eContentType id-ct-TSTInfo, and neither
; document is in this library.
timestamp-token = bstr           ; opaque to CBOR by construction

; ------------------------------------------------- the buckets, as constrained
; §3.2 + §2.2 bullet 1: in TTC mode the token is in the protected bucket, so
; it is inside the signed bytes.
ttc-protected-map = {
    rfc3161-ttc-label => timestamp-token,
    * label => values               ; RFC 9052 §3
}

; §3.1 + §2.1: in CTT mode the token is in the unprotected bucket of an object
; that has ALREADY been signed, so nothing authenticates it. §5 concedes the
; consequence.
ctt-unprotected-map = {
    rfc3161-ctt-label => timestamp-token,
    * label => values
}

; A conforming object carries AT MOST ONE of the two in any one bucket. The
; document never says what a receiver should do with both at once, nor with
; 3161-ttc found unprotected or 3161-ctt found protected; see
; ../design-notes.md Q-3.
ttc-cose-sign1 = [
    protected   : bstr .cbor ttc-protected-map,   ; §3.2: MUST be protected
    unprotected : header_map,
    payload     : bstr,                           ; §3.2: the imprint preimage
    signature   : bstr
]

ctt-cose-sign1 = [
    protected   : empty_or_serialized_map,
    unprotected : ctt-unprotected-map,            ; §3.1: MUST be unprotected
    payload     : bstr / nil,
    signature   : bstr                            ; §3.1.1: 0x5840 || this is
                                                  ; the imprint preimage
]

; ------------------------------------------------------- the imprint preimages
; NOT CBOR TYPES -- byte sequences. Written as CDDL only to pin which octets
; are in each digest, because that is the one thing an implementer gets wrong.
;
; §3.1.1, COSE_Sign1 CTT:  the `signature` field INCLUDING its CBOR head.
;   preimage = 0x58 0x40 || signature          (66 octets for a 64-octet sig)
;   verified: sha256 = 44c2419d131d53d55584b5dd33b788c24e551c6d44b1afc8b2b85e
;             6954763b4e, the printed MessageImprint
;
; §3.1.2, COSE_Sign CTT:   the whole `signatures` ARRAY, heads and all,
;   including each COSE_Signature's protected bstr AND its UNPROTECTED map.
;   preimage = 81 83 43 a10126 a1 04 42 3131 58 40 || signature   (77 octets)
;   verified: sha256 = 803fada2912d6b7a833a27bd961cc05bc1cc164759b1c56f7aa771
;             e4e21526f7, the printed MessageImprint
;
; §3.2, TTC (either structure): the payload bytes ONLY.
;   "This does not include the bstr wrapping -- only the payload bytes."
;   preimage = payload                          (20 octets in Appendix A.1)
;   verified: sha256 = 09e638d4aa95fd7271866203595303bce232f462a94d38e393773c
;             d3aae3f6b0, the printed MessageImprint AND the imprint embedded
;             in the TSTInfo of the token A.1 prints
