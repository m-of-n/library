; ----- BEGIN VERBATIM REGION  source lines 2830-2835  (6 lines)
;       label: Figure 4
;       sha256(region lines joined by LF) = 5321d8c80d08b7e87dee695bdaf9082a49b4f62ad551a1a555aad11379c3a2dd
   app-string-b64  = B *(4(b64dig B))
                     [b64dig B b64dig B ["=" B "=" / b64dig B ["="]] B]
                     ["#" *non-lf]
   b64dig          = ALPHA / DIGIT / "-" / "_" / "+" / "/"
   B               = *lblank *(comment *lblank)
   comment         = "#" *non-lf %x0A
; ----- END VERBATIM REGION  source lines 2830-2835
