; ----- BEGIN VERBATIM REGION  source lines 2758-2765  (8 lines)
;       label: Figure 2
;       sha256(region lines joined by LF) = 934dba471d87b2893d5c5bc39ad648d880e1e70c7dbb9a1f4540c09ff3b1bb5f
   ALPHA           = %x41-5a / %x61-7a
   DIGIT           = %x30-39 ; 0-9
   HEXDIG          = DIGIT / HEXDIGA
   HEXDIGA         = "A" / "B" / "C" / "D" / "E" / "F"
   ; Note: double-quoted strings as in "A" are case-insensitive in ABNF
   lblank          = %x0A / %x20  ; Not HT or CR (gone)
   non-lf          = %x20-7f / NONASCII
   NONASCII        = %x80-D7FF / %xE000-10FFFF
; ----- END VERBATIM REGION  source lines 2758-2765
