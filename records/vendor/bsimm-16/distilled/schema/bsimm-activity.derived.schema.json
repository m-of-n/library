{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bsimm-16/bsimm-activity.derived.schema.json",
  "title": "BSIMM16 framework and scorecard (DERIVED)",
  "description": "DERIVED by this library from the structure of the BSIMM16 report (Part 7 Table 7, Part 8 activity headings, Figures 8 and 18). BSIMM publishes no machine-readable schema. Activity label grammar is from the report's own labels: practice code + level digit + '.' + number.",
  "$defs": {
    "ActivityLabel": {"type": "string", "pattern": "^(SM|CP|T|AM|SFD|SR|AA|CR|ST|PT|SE|CMVM)[123]\\.[0-9]+$"},
    "Domain": {"enum": ["Governance", "Intelligence", "SSDL Touchpoints", "Deployment"]},
    "PracticeCode": {"enum": ["SM", "CP", "T", "AM", "SFD", "SR", "AA", "CR", "ST", "PT", "SE", "CMVM"]},
    "Activity": {
      "type": "object",
      "required": ["label", "practice", "level", "title", "description"],
      "properties": {
        "label": {"$ref": "#/$defs/ActivityLabel"},
        "practice": {"$ref": "#/$defs/PracticeCode"},
        "level": {"enum": [1, 2, 3], "description": "observation-frequency band, not a maturity step (p.45)"},
        "title": {"type": "string", "description": "as printed in the Part 8 heading"},
        "description": {"type": "string"},
        "observation_percentage": {"type": "number", "minimum": 0, "maximum": 100, "description": "heading figure [ID: pct%]"},
        "former_labels": {"type": "array", "items": {"$ref": "#/$defs/ActivityLabel"}, "description": "Table 9 lineage"}
      },
      "additionalProperties": false
    },
    "ScorecardRow": {
      "type": "object",
      "required": ["activity", "firms"],
      "properties": {
        "activity": {"$ref": "#/$defs/ActivityLabel"},
        "firms": {"type": "integer", "minimum": 0, "description": "BSIMM16 FIRMS (OUT OF 111)"},
        "percentage": {"type": "number", "description": "BSIMM16 FIRMS (PERCENTAGE), Figure 18"},
        "example_firm": {"enum": [0, 1], "description": "Figure 8: 1 = activity observed in the firm being scored"}
      }
    },
    "FirmScorecard": {
      "type": "object",
      "description": "A firm's BSIMM scorecard (Part 5; Figure 8): one row per activity; the BSIMM score is taken (INFERRED — the report never defines it) to be the count of observed activities: Figure 17 bins scores of 111 firms in ranges up to 128.",
      "required": ["firm", "edition", "rows"],
      "properties": {
        "firm": {"type": "string"},
        "edition": {"const": "BSIMM16"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/ScorecardRow"}, "minItems": 128, "maxItems": 128},
        "score": {"type": "integer", "minimum": 0, "maximum": 128}
      }
    }
  }
}
