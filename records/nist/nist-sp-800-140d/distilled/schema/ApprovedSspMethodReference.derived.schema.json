{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:library:nist-sp-800-140d:ApprovedSspMethodReference",
 "$comment": "DERIVED, not verbatim. Written by this library from the prose and tables of nist-sp-800-140d (source digest 23a9f6798c641653ca999b5a19838204f6e61ea58b42b21303bdfc00d2c20f0b); it is not the standard's own grammar. Generated by schema/build.derived.py. Describes: one row of the CMVP approved sensitive security parameter generation and establishment methods list: the document that specifies a method.",
 "title": "ApprovedSspMethodReference",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "minLength": 1,
   "pattern": "^nist-sp-800-140d-entry-\\d{2}$"
  },
  "section": {
   "type": "string",
   "minLength": 1,
   "pattern": "^6\\.2\\.[12]$"
  },
  "section_title": {
   "type": "string",
   "minLength": 1
  },
  "ordinal": {
   "type": "integer",
   "minimum": 1,
   "maximum": 12
  },
  "reference": {
   "$ref": "#/$defs/Reference"
  },
  "relevant_sections": {
   "type": "string",
   "minLength": 1
  },
  "notes": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/Note"
   },
   "minItems": 1
  },
  "source_lines": {
   "type": "string",
   "minLength": 1,
   "pattern": "^\\d+(-\\d+)?$"
  },
  "quote": {
   "type": "string",
   "minLength": 1
  },
  "requirements": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "pattern": "^nist-sp-800-140d#R-\\d{4}$"
   },
   "minItems": 1,
   "uniqueItems": true
  }
 },
 "required": [
  "id",
  "section",
  "section_title",
  "reference",
  "source_lines",
  "quote"
 ],
 "additionalProperties": false,
 "$defs": {
  "Reference": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "authors",
    "year",
    "title",
    "publisher",
    "url"
   ],
   "properties": {
    "authors": {
     "type": "string",
     "minLength": 1
    },
    "year": {
     "type": "integer",
     "minimum": 1990,
     "maximum": 2100
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "publisher": {
     "type": "string",
     "minLength": 1
    },
    "series": {
     "type": "string",
     "minLength": 1
    },
    "designation": {
     "type": "string",
     "minLength": 1,
     "pattern": "^(SP|FIPS) [0-9]"
    },
    "revision": {
     "type": "integer",
     "minimum": 1
    },
    "url": {
     "type": "string",
     "minLength": 1,
     "pattern": "^https?://\\S+$"
    }
   }
  },
  "Note": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source_lines",
    "quote"
   ],
   "properties": {
    "source_lines": {
     "type": "string",
     "minLength": 1,
     "pattern": "^\\d+(-\\d+)?$"
    },
    "quote": {
     "type": "string",
     "minLength": 1
    }
   }
  }
 }
}
