{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:library:nist-sp-800-140:Assertion",
 "$comment": "DERIVED, not verbatim. Written by this library from the prose and tables of nist-sp-800-140 (source digest dfb6d1b9c829c3d8caad960a4d0e3bcc076852604061dd755718c259d79fc3f7); it is not the standard's own grammar. Generated by schema/build.derived.py. Describes: one assertion of ISO/IEC 24759 6.x as SP 800-140 modifies it: its id, area, levels and the evidence items under it.",
 "title": "Assertion",
 "type": "object",
 "properties": {
  "assertion_id": {
   "type": "string",
   "minLength": 1,
   "pattern": "^AS\\d{2}\\.\\d{2}$"
  },
  "security_area": {
   "type": "string",
   "minLength": 1
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "levels": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 1,
    "maximum": 4
   },
   "minItems": 1,
   "uniqueItems": true
  },
  "vendor_evidence": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "pattern": "^VE\\d{2}\\.\\d{2}\\.\\d{2}$"
   },
   "uniqueItems": true
  },
  "test_evidence": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "pattern": "^TE\\d{2}\\.\\d{2}\\.\\d{2}$"
   },
   "uniqueItems": true
  },
  "source_lines": {
   "type": "string",
   "minLength": 1,
   "pattern": "^\\d+(-\\d+)?$"
  }
 },
 "required": [
  "assertion_id",
  "security_area",
  "title",
  "levels",
  "vendor_evidence",
  "test_evidence",
  "source_lines"
 ],
 "additionalProperties": false
}
