{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:library:nist-sp-800-140c:ApprovedSecurityFunctionReference",
 "$comment": "DERIVED, not verbatim. Written by this library from the prose and tables of nist-sp-800-140c (source digest 8edf4f1f64bbdf62660f7b1b19f10e95a2d9a5671533530b2eb1dfb9e10dd0f4); it is not the standard's own grammar. Generated by schema/build.derived.py. Describes: one row of the CMVP approved security functions list: a function group and the document that specifies it.",
 "title": "ApprovedSecurityFunctionReference",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "minLength": 1,
   "pattern": "^nist-sp-800-140c-entry-\\d{2}$"
  },
  "section": {
   "type": "string",
   "minLength": 1,
   "pattern": "^6\\.2\\.[1-6]$"
  },
  "section_title": {
   "type": "string",
   "minLength": 1
  },
  "group": {
   "type": "string",
   "minLength": 1
  },
  "functions": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 1
  },
  "reference": {
   "$ref": "#/$defs/Reference"
  },
  "relevant_sections": {
   "type": "string",
   "minLength": 1
  },
  "usage_restriction": {
   "type": "string",
   "minLength": 1
  },
  "notes": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/Note"
   },
   "minItems": 1
  },
  "source_lines": {
   "type": "string",
   "minLength": 1,
   "pattern": "^\\d+(-\\d+)?$"
  },
  "quote": {
   "type": "string",
   "minLength": 1
  },
  "requirements": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "pattern": "^nist-sp-800-140c#R-\\d{4}$"
   },
   "minItems": 1,
   "uniqueItems": true
  }
 },
 "required": [
  "id",
  "section",
  "section_title",
  "source_lines",
  "quote"
 ],
 "additionalProperties": false,
 "$defs": {
  "Reference": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "authors",
    "year",
    "title",
    "publisher",
    "url"
   ],
   "properties": {
    "authors": {
     "type": "string",
     "minLength": 1
    },
    "year": {
     "type": "integer",
     "minimum": 1990,
     "maximum": 2100
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "publisher": {
     "type": "string",
     "minLength": 1
    },
    "series": {
     "type": "string",
     "minLength": 1
    },
    "designation": {
     "type": "string",
     "minLength": 1,
     "pattern": "^(SP|FIPS) [0-9]"
    },
    "revision": {
     "type": "integer",
     "minimum": 1
    },
    "url": {
     "type": "string",
     "minLength": 1,
     "pattern": "^https?://\\S+$"
    }
   }
  },
  "Note": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source_lines",
    "quote"
   ],
   "properties": {
    "source_lines": {
     "type": "string",
     "minLength": 1,
     "pattern": "^\\d+(-\\d+)?$"
    },
    "quote": {
     "type": "string",
     "minLength": 1
    }
   }
  }
 },
 "anyOf": [
  {
   "required": [
    "reference"
   ]
  },
  {
   "required": [
    "usage_restriction"
   ]
  }
 ]
}
