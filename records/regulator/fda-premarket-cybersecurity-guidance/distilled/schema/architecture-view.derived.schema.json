{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:fda-premarket-cybersecurity-guidance:architecture-view.derived",
  "title": "FDA security architecture view (DERIVED)",
  "description": "DERIVED from Sec. V.B.2 and Appendix 2. One view = diagrams + explanatory text, scoped to one of four view types, listing assets and every communication path between any two assets with the per-path details of App. 2.B. This is the structure closest to a threat-model DFD in the guidance; see design-notes.md for the mapping to ARCH-0001 layers 1-2.",
  "type": "object",
  "required": ["view_type", "diagrams", "explanatory_text", "assets", "communication_paths"],
  "properties": {
    "view_type": {"type": "string", "enum": ["global-system", "multi-patient-harm", "updatability-patchability", "security-use-case"]},
    "use_case": {"type": "string", "description": "security-use-case views: the functionality through which a compromise could impact safety or effectiveness (V.B.2.d-02)"},
    "states_covered": {"type": "array", "items": {"type": "string"}, "description": "operational states (power on, standby, transition) and clinical functionality states (programming, alarming, delivering therapy, send/receive data, reporting diagnostic results) (V.B.2.d-03)"},
    "omission_explanation": {"type": "string", "description": "When one of the four minimum views is not appropriate, why (V.B.2-18)"},
    "diagrams": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "ref"], "properties": {"kind": {"type": "string", "examples": ["data flow diagram", "state diagram", "swim-lane diagram", "call-flow diagram"]}, "ref": {"type": "string"}}}},
    "explanatory_text": {"type": "string"},
    "security_context": {"type": "object", "properties": {"domains": {"type": "array", "items": {"type": "string"}}, "boundaries": {"type": "array", "items": {"type": "string"}}, "critical_user_roles": {"type": "array", "items": {"type": "string"}}, "external_interfaces": {"type": "array", "items": {"type": "string"}}}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "communication_paths": {"type": "array", "items": {"$ref": "#/$defs/communication_path"}},
    "security_configuration_defaults": {"type": "array", "items": {"type": "object", "required": ["setting", "default"], "properties": {"setting": {"type": "string"}, "default": {"type": "string"}}}},
    "trace_links": {"type": "array", "description": "Precise links between diagram elements (or explanatory text), associated hazards and controls, and testing (App2.B-28); traceability of architecture elements to security requirements (V.B.2-16)", "items": {"type": "object", "required": ["element"], "properties": {"element": {"type": "string"}, "hazards": {"type": "array", "items": {"type": "string"}}, "controls": {"type": "array", "items": {"type": "string"}}, "tests": {"type": "array", "items": {"type": "string"}}, "security_requirements": {"type": "array", "items": {"type": "string"}}, "sbom_components": {"type": "array", "items": {"type": "string"}}}}},
    "evidence_links": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "category"],
      "properties": {
        "id": {"type": "string"},
        "category": {"type": "string", "enum": ["device-hardware", "directly-interacting-asset", "healthcare-facility-operated", "communications-networking", "manufacturer-controlled"], "description": "The five asset categories of App. 2.B"},
        "functionality": {"type": "string", "description": "primary and all available functionality incl. dormant functionality and assurance it cannot be activated or misused (App2.B-14)"},
        "access_control_model": {"type": "string"},
        "sbom_components": {"type": "array", "items": {"type": "string"}}
      }
    },
    "communication_path": {
      "type": "object",
      "required": ["from", "to", "payload", "protocols"],
      "properties": {
        "from": {"type": "string"}, "to": {"type": "string"},
        "via": {"type": "array", "items": {"type": "string"}, "description": "intermediate assets for indirect paths"},
        "used": {"type": "boolean", "description": "unused interfaces are to be listed too (App2.B-11)"},
        "payload": {"type": "array", "items": {"enum": ["data", "code", "commands"]}, "minItems": 1},
        "payload_types": {"type": "string"},
        "protocols": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "ports_channels_frequencies": {"type": "string"}}}},
        "user_roles": {"type": "array", "items": {"type": "string"}},
        "handoffs": {"type": "array", "items": {"type": "object", "properties": {"from_path": {"type": "string"}, "to_path": {"type": "string"}, "protection": {"type": "string"}}}},
        "error_behavior": {"type": "string"},
        "authentication": {"type": "object", "properties": {"mechanism": {"type": "string"}, "algorithm": {"type": "string"}, "version": {"type": "string"}, "strength": {"type": "string"}, "mode": {"type": "string"}}},
        "cryptography": {"type": "object", "properties": {"method": {"type": "string"}, "key_usage": {"type": "string"}, "standard": {"type": "string"}, "proprietary": {"type": "boolean"}, "expert_analysis_ref": {"type": "string"}}},
        "authenticators": {"type": "array", "items": {"type": "object", "properties": {"authenticator": {"type": "string"}, "verified_at": {"type": "array", "items": {"type": "string"}}, "credential_distribution": {"type": "string"}}}},
        "credentials": {"type": "array", "items": {"type": "object", "properties": {"type": {"type": "string"}, "generated": {"type": "string"}, "stored": {"type": "string"}, "configured": {"type": "string"}, "transferred": {"type": "string"}, "maintained": {"type": "string"}}}},
        "identity_management": {"type": "string"},
        "sessions": {"type": "object", "properties": {"established": {"type": "string"}, "maintained": {"type": "string"}, "broken_down": {"type": "string"}, "identifier_properties": {"type": "array", "items": {"enum": ["uniqueness", "unpredictability", "time-stamping", "verification"]}}}}
      }
    }
  }
}
