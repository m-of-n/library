{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:fda-premarket-cybersecurity-guidance:premarket-cybersecurity-documentation.derived",
  "title": "FDA premarket cybersecurity documentation set (DERIVED from App. 4 Table 1)",
  "description": "DERIVED. One object per submission; one property per Table 1 element. Table 1 'is not intended to serve as merely a deliverable checklist' and 'represents one possible way to organize the recommended information' (App. 4) - so this is a completeness index, not a format FDA accepts. Every element is recommended for all premarket submissions for devices with potential cybersecurity risks (App4-01); for cyber devices the 524B elements are statutory (see allOf).",
  "type": "object",
  "required": ["submission_type", "cyber_device"],
  "properties": {
    "submission_type": {"enum": ["510(k)", "De Novo", "PMA", "PMA supplement", "PDP", "IDE", "HDE", "BLA", "IND"]},
    "cyber_device": {"type": "boolean"},
    "modification": {"enum": ["none", "may-impact-cybersecurity", "unlikely-to-impact-cybersecurity"]},
    "cybersecurity_risk_management_report": {"type": "string", "description": "Sections V, VI.B"},
    "threat_model": {"type": "string", "description": "Sections V.A.1, V.A.3, V.A.4, V.A.5, V.B.2, App. 1, App. 2"},
    "cybersecurity_risk_assessment": {"type": "string"},
    "sbom": {"$ref": "sbom-supplement.derived.schema.json"},
    "vulnerability_assessment_and_software_support": {"type": "string"},
    "unresolved_anomalies_assessment": {"type": "string"},
    "traceability": {"type": "string"},
    "measures_and_metrics": {"type": "object", "properties": {"percent_patched": {"type": "number"}, "mean_days_identification_to_patch": {"type": "number"}, "mean_days_patch_to_field": {"type": "number"}}},
    "architecture_views": {"type": "array", "items": {"$ref": "architecture-view.derived.schema.json"}},
    "security_requirements": {"type": "string"},
    "testing": {"type": "array", "items": {"type": "string"}},
    "labeling": {"type": "string"},
    "cybersecurity_management_plan": {"$ref": "cybersecurity-management-plan.derived.schema.json"},
    "ide": {"type": "object", "properties": {"informed_consent_cyber_risks": {"type": "string"}, "views": {"type": "array"}, "security_use_case_views": {"type": "array"}, "sbom": {"type": "string"}, "general_labeling": {"type": "string"}}}
  },
  "allOf": [
    {"if": {"properties": {"cyber_device": {"const": true}, "submission_type": {"enum": ["510(k)", "De Novo", "PMA", "PMA supplement", "PDP", "HDE"]}}},
     "then": {"required": ["sbom", "cybersecurity_management_plan"]}},
    {"if": {"properties": {"submission_type": {"const": "IDE"}}},
     "then": {"required": ["ide"]}}
  ]
}
