{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:bsi-tr-03185:issue-resolution-decision",
  "title": "Issue management decision",
  "description": "DERIVED from BSI TR-03185 v1.1.1 PROD.FIX.A.8 (the TR defines content, not a format). Required = fields governed by MUST.",
  "type": "object",
  "properties": {
    "disclose": {
      "type": "boolean",
      "description": "constrained_by: PROD.FIX.A.8; source requiredness: True"
    },
    "acceptable_residual_risk": {
      "type": "string",
      "description": "constrained_by: PROD.FIX.A.8; source requiredness: should"
    },
    "remedy": {
      "type": "string",
      "enum": [
        "fix",
        "plan",
        "future-version",
        "no-fix"
      ],
      "description": "constrained_by: PROD.FIX.A.8; source requiredness: True"
    },
    "internal_notifications": {
      "type": "string",
      "description": "constrained_by: PROD.FIX.A.8; source requiredness: should"
    },
    "third_party_notification": {
      "type": "string",
      "description": "constrained_by: PROD.FIX.A.8; source requiredness: should"
    },
    "prevention_recommendations": {
      "type": "string",
      "description": "constrained_by: PROD.FIX.A.8; source requiredness: should"
    }
  },
  "required": [
    "disclose",
    "acceptable_residual_risk",
    "remedy",
    "internal_notifications"
  ],
  "additionalProperties": true
}
