{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://library.m-of-n.example/records/cisa-ssdf-attestation-form-2024/attestation-form.schema.json",
  "title": "CISA Secure Software Development Attestation Form v1.0 (OMB 1670-0052) — DERIVED",
  "description": "DERIVED by the library from the prose/PDF form (pp.5-7 of the instructions PDF, sha256 a8d6b568...dacb). The source publishes no machine schema. Field names are ours; every field carries x-locator. All fields are required per the instructions ('All fields in the attestation form are required to be appropriately completed', p.3) except where the form says 'if applicable'. The two signature paths (CEO/designee signature OR 3PAO assessment attached) are a oneOf. Verifier 2026-10-03: third_party_assessment now requires only what the form has (checkbox + attached assessment); assessor/assessor_basis are optional library extensions.",
  "x-derived": true,
  "type": "object",
  "required": [
    "form_version",
    "attestation_kind",
    "attestation_scope",
    "producer",
    "primary_contact",
    "practices_attested",
    "notify_on_lapse"
  ],
  "properties": {
    "form_version": {
      "const": "1.0",
      "x-locator": "Form header 'Version 1.0', p.5"
    },
    "omb_control_number": {
      "const": "1670-0052",
      "x-locator": "page header; Burden Statement p.8"
    },
    "attestation_kind": {
      "enum": [
        "new",
        "following-extension-or-waiver",
        "revised"
      ],
      "x-locator": "Section I checkboxes, p.5",
      "x-requirement": "cisa-ssdf-attestation-form-2024#I-type"
    },
    "attestation_scope": {
      "enum": [
        "company-wide",
        "individual-product",
        "multiple-products-or-specific-versions"
      ],
      "x-locator": "Section I 'Type of Attestation', p.5",
      "x-requirement": "cisa-ssdf-attestation-form-2024#I-scope"
    },
    "products": {
      "type": "array",
      "x-locator": "Section I product table, p.5 (additional pages may be attached)",
      "x-requirement": "cisa-ssdf-attestation-form-2024#I-products",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "x-locator": "column 'Product(s) Name'"
          },
          "version": {
            "type": "string",
            "description": "if applicable; footnote 4: attestation binds future versions until the producer notifies non-conformance",
            "x-locator": "column 'Version Number (if applicable)'"
          },
          "release_date": {
            "type": "string",
            "format": "date",
            "description": "if applicable",
            "x-locator": "column 'Release/Publish Date (if applicable)'"
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "x-locator": "Section II.1 Software Producer Information, pp.5-6",
      "required": [
        "company_name",
        "address",
        "city",
        "state_or_province",
        "postal_code",
        "country",
        "company_website"
      ],
      "properties": {
        "company_name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state_or_province": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "company_website": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "primary_contact": {
      "type": "object",
      "description": "may be an individual, role, or group",
      "x-locator": "Section II.2, p.6",
      "x-requirement": "cisa-ssdf-attestation-form-2024#II-contact",
      "required": [
        "name",
        "title",
        "address",
        "phone",
        "email"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "may be an alias/distribution list"
        }
      }
    },
    "practices_attested": {
      "description": "Section III items. The form is all-or-nothing: a producer that cannot attest to an item does not submit a partial form but a POA&M package (instructions p.4). Modelled as booleans that must all be true for a valid form.",
      "type": "object",
      "x-locator": "Section III, pp.6-7",
      "required": [
        "1a",
        "1b_i",
        "1b_ii",
        "1c",
        "1d",
        "1e",
        "1f",
        "2",
        "3",
        "4a",
        "4b",
        "4c"
      ],
      "properties": {
        "1a": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.1.a"
        },
        "1b_i": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.1.b.i"
        },
        "1b_ii": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.1.b.ii"
        },
        "1c": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.1.c"
        },
        "1d": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.1.d"
        },
        "1e": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.1.e"
        },
        "1f": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.1.f"
        },
        "2": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.2"
        },
        "3": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.3"
        },
        "4a": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.4.a"
        },
        "4b": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.4.b"
        },
        "4c": {
          "const": true,
          "x-requirement": "cisa-ssdf-attestation-form-2024#III.4.c"
        }
      }
    },
    "notify_on_lapse": {
      "const": true,
      "x-locator": "Section III 'I further attest ... will notify', p.7",
      "x-requirement": "cisa-ssdf-attestation-form-2024#III-notify"
    },
    "signature": {
      "type": "object",
      "x-locator": "Section III signature block, p.7",
      "x-requirement": "cisa-ssdf-attestation-form-2024#III-sign",
      "required": [
        "signed",
        "date",
        "name",
        "title"
      ],
      "properties": {
        "signed": {
          "const": true
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date (YYYY-MM-DD)"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "CEO or designee: an employee of the producer with authority to bind the corporation (INS-14)"
        }
      }
    },
    "third_party_assessment": {
      "type": "object",
      "x-locator": "Section III 'OR' 3PAO box, p.7",
      "x-requirement": "cisa-ssdf-attestation-form-2024#III-3PAO",
      "required": [
        "box_checked",
        "assessment_attachment"
      ],
      "properties": {
        "box_checked": {
          "const": true
        },
        "assessor": {
          "type": "string",
          "description": "NOT a field on the form (verifier 2026-10-03): the form has only the checkbox and the attachment; optional library extension.",
          "x-derived-extension": true
        },
        "assessor_basis": {
          "enum": [
            "fedramp-certified-3pao",
            "3pao-approved-in-writing-by-agency-official"
          ],
          "description": "NOT a field on the form: the form text states the 3PAO is FedRAMP-certified or approved in writing by an agency official (a condition, INS-18), not a value the producer enters; optional library extension.",
          "x-derived-extension": true
        },
        "assessment_attachment": {
          "type": "string",
          "description": "the attached assessment; not to be posted publicly (INS-22)"
        }
      }
    },
    "attachments": {
      "type": "array",
      "x-locator": "Section III ATTACHMENT(S), p.7",
      "items": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attestation_scope": {
            "enum": [
              "individual-product",
              "multiple-products-or-specific-versions"
            ]
          }
        }
      },
      "then": {
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "minItems": 1
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "required": [
            "signature"
          ],
          "not": {
            "required": [
              "third_party_assessment"
            ]
          }
        },
        {
          "required": [
            "third_party_assessment"
          ]
        }
      ]
    }
  ]
}
