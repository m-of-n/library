{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:cisa-secure-by-demand-ot-2025:security-advisory-content.derived",
  "title": "security-advisory-content - DERIVED",
  "description": "DERIVED by the library: What a manufacturer's public disclosure of a security update contains. The guide publishes no schema. Vulnerability Management, L772, L774-778, L807-808.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vulnerability_id",
    "description",
    "root_cause",
    "cwe",
    "affected_products",
    "impacts",
    "severity",
    "remediation_information"
  ],
  "properties": {
    "vulnerability_id": {
      "type": "string",
      "pattern": "^CVE-\\d{4}-\\d{4,}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "root_cause": {
      "type": "string",
      "minLength": 1
    },
    "cwe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^CWE-\\d+$"
      }
    },
    "affected_products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "impacts": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "minLength": 1
    },
    "remediation_information": {
      "type": "string",
      "minLength": 1
    }
  }
}
