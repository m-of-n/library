{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:library:cisa-secure-by-demand-ot-2025:security-event-record.derived",
  "title": "security-event-record - DERIVED",
  "description": "DERIVED by the library: What every event record includes. The guide publishes no schema. Logging in the Baseline Product, L362-363.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "source_address",
    "source_port",
    "affected_account",
    "correlation_id",
    "event_description"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "source_address": {
      "type": "string",
      "minLength": 1
    },
    "source_port": {
      "type": [
        "integer",
        "string"
      ],
      "minimum": 0,
      "maximum": 65535,
      "minLength": 1
    },
    "affected_account": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "event_description": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "authentication",
        "log-integrity",
        "device-change",
        "data-event",
        "error"
      ]
    }
  }
}
