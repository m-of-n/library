#!/usr/bin/env python3
"""reindex — regenerate every derived view of the library.

Output is DETERMINISTIC: no timestamps. A generated file that embeds the
current date changes every day, so a staleness check can never pass on a
later day — the gate then cries wolf and gets disabled. Provenance comes
from git log, which is what it is for.

index/ is GENERATED. Never edit it; regenerate it.

Produces:
  index/records.md        everything, by body
  index/versions.md       folded versions — so a superseded version is findable
  index/crosswalk.md      the relation graph, dangling edges, orphans
  index/bibliography.md   human-readable bibliography
  index/frontier.md       cites with no record — the ingestion queue
  index/by-decision.md    records grouped by the DEC-*/R-* they bear on

Inverse relations are DERIVED here, never authored, so the two sides cannot
drift. Run after any ingestion or relation edit; CI fails if stale.
"""
import pathlib, re, sys, collections
ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "bin"))
from _yaml import parse as miniyaml
IDX = ROOT / "index"

INVERSE = {"supersedes": "superseded_by", "superseded_by": "supersedes",
           "updates": "updated_by", "updated_by": "updates",
           "part_of": "has_part", "contradicts": "contradicts",
           "see_also": "see_also"}
BANNER = ("<!-- GENERATED by bin/reindex — do not edit. "
          f"Regenerate after any ingestion or relation edit. -->\n\n")


def listify(v):
    if isinstance(v, list):
        return [x.strip() for x in v if x and x.strip() not in ("[]", "")]
    return []


def load():
    recs = {}
    for f in sorted((ROOT / "records").glob("*/*/record.yaml")):
        d = miniyaml(f.read_text())
        rid = f.parent.name
        d["_body"] = f.parent.parent.name
        d["_path"] = f"records/{d['_body']}/{rid}"
        d["_versions"] = sorted(p.name for p in (f.parent / "versions").glob("*")) \
            if (f.parent / "versions").is_dir() else []
        d["_has_summary"] = (f.parent / "summary.md").exists()
        recs[rid] = d
    return recs


def main():
    recs = load()
    IDX.mkdir(exist_ok=True)
    rel_out = collections.defaultdict(lambda: collections.defaultdict(list))
    dangling, frontier = [], []

    for rid, d in recs.items():
        rel = d.get("relations", {})
        if isinstance(rel, dict):
            for kind, targets in rel.items():
                for t in listify(targets):
                    if t in recs:
                        rel_out[rid][kind].append(t)
                        inv = INVERSE.get(kind)
                        if inv and rid not in rel_out[t][inv]:
                            rel_out[t][inv].append(rid)
                    else:
                        dangling.append((rid, kind, t))
        for c in listify(d.get("cites")):
            (frontier if c not in recs else rel_out[rid]["cites"]).append(c) \
                if c not in recs else rel_out[rid]["cites"].append(c)
            if c not in recs:
                frontier.append((rid, c))

    # ---- records.md
    by_body = collections.defaultdict(list)
    for rid, d in recs.items():
        by_body[d["_body"]].append((rid, d))
    out = [BANNER, f"# Records\n\n{len(recs)} records across {len(by_body)} bodies.\n"]
    for body in sorted(by_body):
        out.append(f"\n## {body}\n\n| id | title | type | maturity | status | useful | versions |\n|---|---|---|---|---|---|---|")
        for rid, d in sorted(by_body[body]):
            u = d.get("usefulness", {})
            u = u.get("verdict", "—") if isinstance(u, dict) else "—"
            nv = len(d["_versions"])
            out.append(f"| [`{rid}`](../{d['_path']}/) | {d.get('title','')[:58]} | {d.get('type','')} | "
                       f"{d.get('maturity','—')} | {d.get('status','')} | {u} | {nv or '—'} |")
    (IDX / "records.md").write_text("\n".join(out) + "\n")

    # ---- versions.md  (the sponsor's ask: find folded documents)
    out = [BANNER, "# Folded versions\n",
           "Superseded versions live inside their record at `versions/<version>/`,",
           "not as sibling records (scope §5). This index makes them findable.\n"]
    folded = [(r, d) for r, d in sorted(recs.items()) if d["_versions"]]
    if folded:
        out.append("| record | current | folded versions |\n|---|---|---|")
        for rid, d in folded:
            out.append(f"| [`{rid}`](../{d['_path']}/) | {d.get('version','—')} | "
                       + ", ".join(f"`{v}`" for v in d["_versions"]) + " |")
    else:
        out.append("_No folded versions yet._\n\nA record gains one when a tracked document")
        out.append("revises and the prior version is kept: `versions/<version>/`.")
    (IDX / "versions.md").write_text("\n".join(out) + "\n")

    # ---- crosswalk.md
    out = [BANNER, "# Crosswalk\n",
           "How records relate. **Inverse edges are derived here, never authored** —",
           "write `supersedes` on one record and `superseded_by` appears on the other.\n",
           "`cites` is what a document itself references (fact). Everything else is",
           "our curatorial judgement. See [`docs/references.md`](../docs/references.md).\n"]
    linked = {r for r in recs if rel_out.get(r)}
    out.append(f"{len(linked)} of {len(recs)} records have at least one edge.\n")
    for rid in sorted(linked):
        out.append(f"\n### `{rid}`")
        for kind in sorted(rel_out[rid]):
            ts = ", ".join(f"`{t}`" for t in sorted(set(rel_out[rid][kind])))
            if ts:
                out.append(f"- **{kind}** → {ts}")
    orphans = sorted(set(recs) - linked)
    out.append("\n## Orphans\n\nNo edges in or out. Not wrong — but a record connected to nothing")
    out.append("is a record nothing will surface.\n")
    out.append("\n".join(f"- `{o}`" for o in orphans) if orphans else "_none_")
    out.append("\n## Dangling relations\n\nPointing at a record that does not exist. **These are errors.**\n")
    out.append("\n".join(f"- `{a}` **{k}** → `{t}` (no such record)" for a, k, t in sorted(dangling))
               if dangling else "_none_")
    (IDX / "crosswalk.md").write_text("\n".join(out) + "\n")

    # ---- frontier.md
    out = [BANNER, "# Ingestion frontier\n",
           "Documents cited by records we hold, that we do **not** hold.",
           "This is the snowballing queue (Wohlin backward pass).\n"]
    if frontier:
        out.append("| cited by | target |\n|---|---|")
        out += [f"| `{a}` | {t} |" for a, t in sorted(set(frontier))]
    else:
        out.append("_Empty — no `cites` recorded yet. Populated as documents are converted and their_")
        out.append("_reference sections extracted._")
    (IDX / "frontier.md").write_text("\n".join(out) + "\n")

    # ---- by-decision.md
    bd = collections.defaultdict(list)
    for rid, d in recs.items():
        for b in listify(d.get("bears_on")) or ["(none — stub or unassessed)"]:
            bd[b].append(rid)
    out = [BANNER, "# By decision\n", "Which records bear on which `DEC-*` / `R-*`.",
           "This is the query the library exists to answer.\n"]
    for k in sorted(bd):
        out.append(f"\n### {k}\n")
        out += [f"- [`{r}`](../{recs[r]['_path']}/) — {recs[r].get('title','')[:70]}" for r in sorted(bd[k])]
    (IDX / "by-decision.md").write_text("\n".join(out) + "\n")

    # ---- bibliography.md
    out = [BANNER, "# Bibliography\n", f"{len(recs)} records.\n"]
    for body in sorted(by_body):
        out.append(f"\n## {body}\n")
        for rid, d in sorted(by_body[body]):
            a = d.get("authors")
            a = ", ".join(listify(a)) if isinstance(a, list) else ""
            ident = d.get("identifiers", {})
            ident = ident.get("rfc") and f"RFC {ident['rfc']}" or (ident.get("doi") or "")
            bits = [b for b in [a, d.get("date", ""), ident] if b]
            out.append(f"- **{d.get('title', rid)}**"
                       + (f" — {'. '.join(bits)}" if bits else "")
                       + f"  \n  `{rid}` · {d.get('type','')}"
                       + (f" · {d.get('maturity')}" if d.get("maturity")
                          and d.get("maturity") != d.get("type") else "")
                       + (f" · **{d.get('status')}**" if d.get("status") in
                          ("summarized", "distilled") else "")
                       + (f" · [source]({d.get('content',{}).get('url','')})"
                          if isinstance(d.get("content"), dict) and d["content"].get("url") else "")
                       + (f"  \n  _{(d.get('usefulness') or {}).get('reason','')}_"
                          if isinstance(d.get("usefulness"), dict)
                          and d["usefulness"].get("reason") else ""))
    (IDX / "bibliography.md").write_text("\n".join(out) + "\n")

    stale = [r for r, d in recs.items()
             if d.get("status") in {"read", "summarized", "distilled"} and not d["_has_summary"]]
    print(f"reindex: {len(recs)} records → index/ "
          f"({len(dangling)} dangling, {len(orphans)} orphans, {len(set(frontier))} frontier)")
    if stale:
        print(f"  warn: {len(stale)} record(s) claim a read status with no summary.md")
    return 1 if dangling else 0


if __name__ == "__main__":
    sys.exit(main())
