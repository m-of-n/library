#!/usr/bin/env python3
"""check-id-joins — where can a cited requirement id be WRONG but not dangling?

The defect this exists for: a `constrained_by` or `Derived from` citation that
resolves to a real requirement which is not the one meant. It is not dangling,
so no closure check sees it; the text is verbatim, so no verbatim check sees
it; the locator is right, so bin/check-locators passes it. Two lanes in
library#39 shipped 41 of these between them (30 in one record's messages.yaml,
11 more in the files that pass never audited), and every one was found only by
resolving the id and reading the sentence back.

Two things it does, both cheap:

  --surface   List the requirements that share IDENTICAL text. A group of size
              greater than one is the ONLY place a wrong id can still match the
              quoted words, so it is the complete attack surface for this
              class. rfc-9277 has exactly two such groups and BOTH were
              mis-joined; its sibling rfc-8742 has zero, which is structurally
              why that record was clean at 0 of 243 citations.

  --resolve   Print every cited id beside its own requirement's locator and
              the opening of its text, so a verifier can read the pairs
              instead of hand-building the harness. Four passes built this by
              hand before it was a tool.

  --quote-join
              The mechanised version of reading those pairs. Wherever a
              QUOTATION sits immediately beside a citation, assert the quoted
              span is a substring of THAT id's own text. This is what actually
              catches the defect: rfc-9277's cross-check found SIX wrong ids
              with it, all in distilled/schema/, one of them citing a member of
              a duplicate-text group — which is why --surface alone could not
              have found it. Across library#39 it would have caught eight.

    bin/check-id-joins --surface --all
    bin/check-id-joins --resolve records/ietf/rfc-9277
    bin/check-id-joins --quote-join --all

Exit 1 if any citation dangles, else 0. A duplicate-text group is not a defect
and does not affect the exit status — it is a place to look. A --quote-join
mismatch is a finding to READ, not an error, for the same reason, and it is
scoped deliberately narrowly; see `_adjacent_quote`.
"""
import argparse
import collections
import pathlib
import re
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from _yaml import parse as miniyaml

ROOT = pathlib.Path(__file__).resolve().parent.parent
# A citation carrying its record name. The bare form is deliberately NOT
# collected: inside a record's own files it correctly means that record, and
# bin/validate already warns where a bare form is ambiguous with a sibling's.
CITE = re.compile(r"(?<![\w.\-…])([a-z0-9][a-z0-9.\-]*?)#((?:R|V|G|N)-[0-9]+)\b")
SCAN = {".yaml", ".md", ".txt", ".cddl", ".abnf", ".json"}
MIN_TEXT = 40          # below this, identical text is a coincidence, not a trap


def _entries(path, key):
    try:
        d = miniyaml(path.read_text(errors="ignore")) or {}
    except Exception:                                    # noqa: BLE001
        return []
    v = d.get(key)
    return v if isinstance(v, list) else []


def requirements(recdir):
    """{bare id: (locator, text)} for one record.

    R-ids come from requirements.yaml and V-ids from examples/vectors.yaml,
    which are the two namespaces with a canonical home. G- and N- ids live in
    per-record derived files whose shape varies by record, so they are left to
    bin/validate's collision check rather than resolved here — reporting them
    as dangling would be this tool's error, not the record's.
    """
    out = {}
    for r in _entries(recdir / "distilled" / "requirements.yaml", "requirements"):
        if isinstance(r, dict) and r.get("id"):
            out[str(r["id"]).split("#")[-1]] = (
                str(r.get("locator") or ""),
                " ".join(str(r.get("text") or "").split()))
    for v in _entries(recdir / "distilled" / "examples" / "vectors.yaml", "vectors"):
        if isinstance(v, dict) and v.get("id"):
            out[str(v["id"]).split("#")[-1]] = (
                str(v.get("locator") or v.get("source_lines") or ""),
                " ".join(str(v.get("matches") or v.get("notes")
                             or v.get("expect") or "").split()))
    return out


def surface(recdir, rid):
    """Groups of requirements whose text is identical."""
    groups = collections.defaultdict(list)
    for bare, (_, text) in requirements(recdir).items():
        if len(text) >= MIN_TEXT:
            groups[text].append(bare)
    return {k: sorted(v) for k, v in groups.items() if len(v) > 1}


def citations(recdir):
    """[(file, record, bare id)] for every record-qualified citation."""
    out = []
    for f in sorted(x for x in recdir.rglob("*") if x.is_file()):
        if f.suffix not in SCAN:
            continue
        try:
            text = f.read_text(errors="ignore")
        except OSError:
            continue
        for who, i in CITE.findall(text):
            if i[0] in "GN":        # no canonical home; see requirements()
                continue
            out.append((f.relative_to(recdir), who, i))
    return out


# --- quote-join -------------------------------------------------------------
#
# The scoping matters more than the comparison, because the first version of
# any new check in this library has over-reported (four for four). The pass
# that hand-built this found 6 real defects against 14 false positives, and
# every false positive was one of five shapes. Each is excluded below:
#
#   1. a `constrained_by` LIST beside a note quoting a different field's
#      statement — a list of ids is not an attribution, so lists are skipped
#   2. a `no id` bullet whose commentary names some other id
#   3. a CORRECTION note, which quotes the wording it is correcting and cites
#      the id it says is wrong — the most common shape in this library
#   4. UNDER-citation: a span covering two adjacent requirements that cites
#      only one. Reported separately as `partial`, never as a mismatch
#   5. an explicit disclaimer ("R-0017's neighbour"), i.e. prose that says the
#      id is NOT the span's own
#
# Anything still flagged is a pair a human must read. Keep it that way.

QUOTE = re.compile(r"[\"“]([^\"“”]{40,1200})[\"”]", re.S)
# A candidate that contains YAML structure is not a quotation: it is the text
# BETWEEN two quote marks belonging to different scalars. Measured: without
# this, messages.yaml alone supplied thousands of "quotations" made of
# `name:`/`index:`/`- ` lines, and the check flagged 4479 of 4482 pairs.
_YAMLISH = re.compile(r"\n\s*(?:-\s|[A-Za-z_][\w.-]*:(?:\s|$))")
# Prose that means "the id beside this quotation is not its id".
_DISCLAIM = re.compile(
    r"correction|corrected|this read|was cited|should be|not the one|"
    r"neighbour|neighbor|no id\b|wrong id|mis-?join", re.I)
_LIST_CTX = re.compile(r"constrained_by|requirements:\s*\[|\bids:\s*\[")


# A quotation wrapped inside a comment block carries the comment marker on
# every continuation line. rfc-8742 quoted a requirement verbatim in an .abnf
# file and the span came back as "... encoded CBOR data ; items generates ...".
# Stripping the marker is part of normalising, not a relaxation.
_COMMENT_CONT = re.compile(r"\s*(?:;+|#+|//+)\s*")


def _norm(s):
    return " ".join(_COMMENT_CONT.sub(" ", s).split())


# A span of braces, brackets and punctuation is not a quotation: it is the text
# between two quote marks of a JSON or CDDL structure. rfc-9679's derived JSON
# Schema supplied `"} } } } }, {"` this way. Require real words.
def _is_prose(s):
    if len(re.findall(r"[A-Za-z]{2,}", s)) < 5:
        return False
    # Two or more `key: value` pairs on one line is a YAML flow mapping, not a
    # sentence. _YAMLISH only sees structure that spans a newline, and
    # slsa-1-2's vectors supplied `", schema: ..., expected: invalid, result:"`
    # on a single line.
    return len(re.findall(r"[A-Za-z_][\w.-]*:\s", s)) < 2


# An elision is a legitimate quotation shape in this library, declared and
# visible. Plain substring matching fails on every one of them, and they were
# the largest remaining false-positive class once multi-id attribution was
# handled, so they are resolved segment by segment instead.
_ELLIPSIS = re.compile(r"\s*(?:…|\.\.\.)\s*")


def _carries(quote, target):
    """Is `quote` — possibly elided — a span of `target`?"""
    parts = [p for p in _ELLIPSIS.split(quote) if len(p) > 3]
    if not parts:
        return False
    i = 0
    for p in parts:
        j = target.find(p, i)
        if j < 0:
            return False
        i = j + len(p)
    return True


# Between a closing quote and the citation that attributes it, only this may
# stand. Measured: a 120-character window with "no long word between" flagged
# 9135 of 9171 pairs library-wide — in dense prose there is nearly always SOME
# quotation nearby, and it is usually not an attribution of that id. Requiring
# true adjacency is the whole scope of the check.
_JOIN = re.compile(r"^[\s—–()\[\]{}*`,;:.\-]{0,14}$")


def _adjacent_quote(text, pos, end):
    """The quoted span this citation ATTRIBUTES, if any.

    BOTH directions, because both occur and each caught a real defect:
      `"…" (rec#R-0001)`   the citation follows the closing delimiter
      `(rec#R-0001): "…"`  the citation introduces the quotation
    Either way only whitespace, a bracket, a dash or light punctuation may
    stand between. Anything else is proximity, not attribution.
    """
    window = text[max(0, pos - 1400):pos]
    for m in reversed(list(QUOTE.finditer(window))):
        if _JOIN.match(window[m.end():]) and not _YAMLISH.search(m.group(1)):
            return m.group(1)
    ahead = text[end:end + 1400]
    m = QUOTE.search(ahead)
    if m and _JOIN.match(ahead[:m.start()]) and not _YAMLISH.search(m.group(1)):
        return m.group(1)
    return None


def quote_joins(recdir, known):
    """[(file, line, ids, quote, verdict)] for each attributed quotation.

    Driven by the CITATION, with quote pairing done inside a window around it.
    Pairing quote marks across a whole file was tried and abandoned: these
    files carry apostrophes, inch marks and nested quotations, so an unbalanced
    mark anywhere above shifts every span below it and the real quotation stops
    being found at all. A window re-pairs locally and is stable.

    A sentence routinely cites SEVERAL ids — `(§2.2.4, rec#R-0027; Appendix C,
    rec#R-0101). "…"` — where the quotation belongs to one of them and not the
    nearest. Comparing against the nearest alone flagged eight such sentences
    in rfc-8610 when every one was correctly attributed, so the quotation is
    accepted if it is in ANY id cited in the same breath.
    """
    out = []
    for f in sorted(x for x in recdir.rglob("*") if x.is_file()):
        if f.suffix not in SCAN:
            continue
        try:
            text = f.read_text(errors="ignore")
        except OSError:
            continue
        seen = set()
        for m in CITE.finditer(text):
            who, bare = m.group(1), m.group(2)
            if bare[0] in "GN" or bare not in known.get(who, {}):
                continue
            quote = _adjacent_quote(text, m.start(), m.end())
            if not quote or not _is_prose(quote):
                continue
            pos = m.start()
            line_start = text.rfind("\n", 0, pos) + 1
            line_end = text.find("\n", pos)
            ctx = text[max(0, pos - 400):pos + 240]
            back = text[max(0, line_start - 240):pos]
            if _LIST_CTX.search(back) or _DISCLAIM.search(ctx):
                continue                      # shapes 1, 2, 3 and 5
            q = _norm(quote)
            key = (f, q)
            if key in seen:
                continue
            # Every id cited in the same breath may be the quotation's source.
            sent = text[max(0, line_start - 220):
                        (line_end if line_end > 0 else len(text)) + 60]
            ids = []
            for c in CITE.finditer(sent):
                w, b = c.group(1), c.group(2)
                if b[0] not in "GN" and b in known.get(w, {}) \
                        and (w, b) not in ids:
                    ids.append((w, b))
            if (who, bare) not in ids:
                ids.append((who, bare))
            if any(_carries(q, _norm(known[w][b][1])) for w, b in ids):
                continue
            seen.add(key)
            # shape 4: under-citation — the span runs into the next id
            joined = []
            for w, b in ids:
                n = int(b.split("-")[1])
                nxt = known[w].get("%s-%04d" % (b.split("-")[0], n + 1))
                joined.append(_norm(known[w][b][1]) + " " +
                              _norm(nxt[1] if nxt else ""))
            verdict = ("partial" if any(_carries(q, j) for j in joined)
                       else "MISMATCH")
            out.append((f.relative_to(recdir),
                        text.count("\n", 0, pos) + 1,
                        ["%s#%s" % (w, b) for w, b in ids], q, verdict))
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("records", nargs="*")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--surface", action="store_true",
                    help="list requirements sharing identical text")
    ap.add_argument("--resolve", action="store_true",
                    help="print every citation beside the text it resolves to")
    ap.add_argument("--quote-join", action="store_true",
                    help="assert each quotation beside a citation is a "
                         "substring of THAT id's text")
    ap.add_argument("--width", type=int, default=90,
                    help="characters of resolved text to print (default 90)")
    a = ap.parse_args()
    if not (a.surface or a.resolve or a.quote_join):
        a.surface = True

    if a.all:
        dirs = sorted(p.parent for p in ROOT.glob("records/*/*/distilled"))
    else:
        dirs = [pathlib.Path(x).resolve() for x in a.records]
    if not dirs:
        ap.error("name at least one record directory, or pass --all")

    # Every record's requirements, so a cross-record citation can be resolved.
    known = {d.name: requirements(d) for d in sorted(ROOT.glob("records/*/*"))
             if d.is_dir()}

    tot_groups = tot_cites = tot_dangling = 0
    tot_pairs = tot_mismatch = tot_partial = 0
    for recdir in dirs:
        rid = recdir.name
        where = recdir.relative_to(ROOT) if recdir.is_relative_to(ROOT) else recdir
        if a.surface:
            g = surface(recdir, rid)
            if g:
                n = sum(len(v) for v in g.values())
                print(f"  ~ {where}: {len(g)} duplicate-text group(s), {n} "
                      f"requirement(s) — a wrong id here still matches the words")
                for text, ids in sorted(g.items(), key=lambda kv: kv[1]):
                    print(f"      {', '.join(ids)}")
                    print(f"        \"{text[:a.width]}...\"")
            tot_groups += len(g)
        if a.resolve:
            for rel, who, i in citations(recdir):
                tot_cites += 1
                tgt = known.get(who, {})
                if i not in tgt:
                    tot_dangling += 1
                    print(f"  ! {where}: {rel} cites {who}#{i} — NO SUCH ID")
                    continue
                loc, text = tgt[i]
                print(f"  {who}#{i}  ({loc})  {text[:a.width]}")
                print(f"      cited by {rel}")
        if a.quote_join:
            pairs = quote_joins(recdir, known)
            tot_pairs += len(pairs)
            for rel, ln, cids, quote, verdict in pairs:
                if verdict == "partial":
                    tot_partial += 1
                    continue
                tot_mismatch += 1
                print(f"  ? {where}: {rel}:{ln} — a quotation attributed to "
                      f"{', '.join(cids)} is in NONE of their texts")
                print(f"        quoted : \"{quote[:a.width]}\"")
                for cid in cids:
                    loc, text = known[cid.split("#")[0]][cid.split("#")[1]]
                    print(f"        {cid} ({loc}): \"{text[:a.width]}\"")

    print(f"\n{len(dirs)} record(s)"
          + (f", {tot_groups} duplicate-text group(s)" if a.surface else "")
          + (f", {tot_cites} citation(s), {tot_dangling} dangling"
             if a.resolve else "")
          + (f", {tot_pairs} quotation/citation pair(s), {tot_mismatch} to read"
             + (f", {tot_partial} spanning the next id too" if tot_partial
                else "")
             if a.quote_join else ""))
    return 1 if tot_dangling else 0


if __name__ == "__main__":
    sys.exit(main())
