#!/usr/bin/env python3
"""check-pr-extraction — FX-1 applies to every in-scope record a PR touches.

    bin/check-pr-extraction <base-ref>

A record of type rfc/draft/spec/ietf that the PR adds or changes must declare
distillation.profile: full; bin/validate then enforces the artifact set.
Records the PR does not touch are grandfathered (docs/extraction.md).

A PR may add an in-scope record as a *stub* (status stub or queued) without
extraction — that is ingestion, not a finished lane. Anything summarized or
beyond must be fully extracted.
"""
import pathlib, subprocess, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from _yaml import parse

ROOT = pathlib.Path(__file__).resolve().parent.parent
IN_SCOPE = {"rfc", "draft", "spec", "ietf"}
STUB_OK = {"stub", "queued"}

if len(sys.argv) < 2:
    print(__doc__); sys.exit(2)
changed = subprocess.run(["git", "diff", "--name-only", f"{sys.argv[1]}...HEAD", "--", "records/"],
                         cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
recs = sorted({pathlib.Path(*pathlib.Path(p).parts[:3]) for p in changed if len(pathlib.Path(p).parts) >= 3})
bad = []
for r in recs:
    y = ROOT / r / "record.yaml"
    if not y.exists():
        continue                                  # removed or moved
    d = parse(y.read_text())
    if d.get("type") not in IN_SCOPE or d.get("status") in STUB_OK:
        continue
    prof = (d.get("distillation") or {}).get("profile") if isinstance(d.get("distillation"), dict) else None
    if prof != "full":
        bad.append(f"{r}  (type {d.get('type')}, status {d.get('status')}, profile {prof or 'none'})")
print(f"check-pr-extraction: {len(recs)} record(s) touched")
if bad:
    print("\nFX-1 not met — these in-scope records are past stub but not fully extracted:")
    for b in bad: print("  " + b)
    print("\nSee docs/extraction.md. Start with: bin/extract-scaffold <record-dir>")
    sys.exit(1)
print("FX-1: every touched in-scope record is fully extracted or a stub")
