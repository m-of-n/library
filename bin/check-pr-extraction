#!/usr/bin/env python3
"""check-pr-extraction — FX-1 applies to every record a PR extracts.

    bin/check-pr-extraction <base-ref>

FX-1 (docs/extraction.md) is triggered by the INTENT TO EXTRACT, not by mere
contact with a record. A PR that only summarises an in-scope record is doing
ingestion, not extraction, and is held to the summary bar instead.

A touched record of type rfc/draft/spec/ietf must declare
distillation.profile: full when any of these is true — bin/validate then
enforces the artifact set:

  * the PR adds to or changes its distilled/   the PR is extracting now
  * status: distilled, AND the record's        the record claims to be
    distillation.standard is the current       extracted under the standard
    standard                                   we enforce
  * a `distillation` block is present, same
    condition on its standard

A record whose `distillation.standard` names an OLDER standard is
GRANDFATHERED — held to the summary bar, as docs/extraction.md has always
said and as nothing implemented until library#73. The vintage is what makes
that a comparison the gate can make instead of a sentence only people could
read. Omitting `standard` means the current one, so new work fails closed.

This is still a ratchet: once a record is extracted under the current standard
the first two conditions keep firing on every later PR that touches it, and
grandfathering never licenses editing `distilled/` — that is extraction.

The rule itself lives in bin/_fx1.py, and the vintages in
schema/record.schema.yaml. It is stated once because it used to be stated
three ways (library#73).
"""
import pathlib, subprocess, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from _yaml import parse
import _fx1

ROOT = pathlib.Path(__file__).resolve().parent.parent

if len(sys.argv) < 2:
    print(__doc__); sys.exit(2)
CURRENT = _fx1.current()
changed = subprocess.run(["git", "diff", "--name-only", f"{sys.argv[1]}...HEAD", "--", "records/"],
                         cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
paths = [pathlib.Path(p) for p in changed if len(pathlib.Path(p).parts) >= 3]
recs = sorted({pathlib.Path(*p.parts[:3]) for p in paths})
# records whose distilled/ this PR adds to or changes — extraction in progress
extracting = {pathlib.Path(*p.parts[:3]) for p in paths
              if len(p.parts) >= 4 and p.parts[3] == "distilled"}

bad, summarised_only, grandfathered = [], [], []
for r in recs:
    y = ROOT / r / "record.yaml"
    if not y.exists():
        continue                                  # removed or moved
    d = parse(y.read_text())
    why = _fx1.trigger(d, extracting=r in extracting, cur=CURRENT)
    if why is None:
        if d.get("type") in _fx1.IN_SCOPE and d.get("status") not in _fx1.STUB_OK \
                and _fx1.vintage(d, CURRENT) != CURRENT:
            grandfathered.append(f"{r}  (type {d.get('type')}, status {d.get('status')}, "
                                 f"standard {_fx1.vintage(d, CURRENT)} — current is {CURRENT})")
        else:
            summarised_only.append(f"{r}  (type {d.get('type')}, status {d.get('status')})")
        continue
    dist = d.get("distillation") if isinstance(d.get("distillation"), dict) else None
    if (dist or {}).get("profile") != "full":
        reason = {"extracting": "PR touches distilled/",
                  "distilled": "status: distilled",
                  "declared": "distillation declared"}[why]
        bad.append(f"{r}  (type {d.get('type')}, status {d.get('status')}, "
                   f"profile {(dist or {}).get('profile') or 'none'} — under "
                   f"{CURRENT} because {reason})")

print(f"check-pr-extraction: {len(recs)} record(s) touched; current standard {CURRENT}")
if summarised_only:
    print(f"\nsummary bar ({len(summarised_only)}) — not extracting, {CURRENT} not required:")
    for s in summarised_only: print("  " + s)
if grandfathered:
    print(f"\ngrandfathered ({len(grandfathered)}) — extracted under an earlier standard, "
          f"held to the summary bar (docs/extraction.md):")
    for g in grandfathered: print("  " + g)
if bad:
    print(f"\n{CURRENT} not met — these records are being extracted but are not complete:")
    for b in bad: print("  " + b)
    print("\nSee docs/extraction.md. Start with: bin/extract-scaffold <record-dir>")
    sys.exit(1)
print(f"{CURRENT}: every record this PR extracts is complete")
