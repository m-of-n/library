#!/usr/bin/env python3
"""Write records/<body>/<id>/summary.html beside each record's source.

    bin/render-html            # every record
    bin/render-html ID [ID…]   # just these

Generated and untracked, like index/ (docs/generated-views.md). A publisher
imports bin/_record_html.py and copies the pages; see that module's docstring.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _record_html  # noqa: E402

records = _record_html.load_all()
paths = _record_html.render(records, sys.argv[1:] or None)
print(f"render-html: {len(paths)} pages written beside their records ({len(records)} records)")
