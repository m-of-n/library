#!/usr/bin/env python3
"""bcp14-count — count normative BCP 14 keywords in a source document.

    bin/bcp14-count <source.txt> [--by-keyword]

Put the result in distilled/requirements.yaml as source_keyword_count. Run it
on the plain-text source (RFC .txt, or a pdftotext rendering) — never on our
own summary or normative.md.
"""
import pathlib, sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import _bcp14

if len(sys.argv) < 2:
    print(__doc__); sys.exit(2)
t = pathlib.Path(sys.argv[1]).read_text(errors="replace")
print(_bcp14.count(t))
if "--by-keyword" in sys.argv:
    for k, v in sorted(_bcp14.by_keyword(t).items(), key=lambda x: -x[1]):
        print(f"  {k:16} {v}")
