#!/usr/bin/env python3
"""validate — check every record and topic against the library schema.

Deliberately dependency-free: a tiny YAML subset parser, so CI needs no pip
install and a student can run it on a fresh machine. If records ever need
real YAML, swap in ruamel and delete miniyaml().
"""
import pathlib, re, sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from _yaml import parse as miniyaml
import _record_yaml
import _bcp14

ROOT = pathlib.Path(__file__).resolve().parent.parent
REQUIRED = ["schema", "id", "body", "type", "title", "content", "tags", "status"]


def bodies():
    """The legal `body` values, read from the schema rather than restated here.

    This list used to be a literal in three places (here and twice in
    bin/ingest) plus schema/tags.yaml, and the tags.yaml copy drifted out of
    agreement with the schema — library#27. One declaration,
    schema/record.schema.yaml:fields.body, parsed at run time.
    """
    f = ROOT / "schema" / "record.schema.yaml"
    v = (miniyaml(f.read_text()).get("fields") or {}).get("body", {}).get("values")
    if not isinstance(v, list) or not v:
        sys.exit(f"ERROR {f}:fields.body.values is not a non-empty list — "
                 f"it must stay a BLOCK sequence; miniyaml cannot read a flow list")
    return v


BODIES = bodies()
VERDICTS = {"useful", "marginal", "not-useful", "unassessed"}
STATUS = {"stub", "queued", "fetched", "reading", "read", "summarized", "distilled"}
TYPES = {"rfc", "draft", "spec", "paper", "book", "article", "repo", "dataset",
         "consortium", "hierarchy", "spreadsheet", "web", "note", "ietf", "url", "md"}
FX1 = "FX-1"   # the extraction standard in force; see docs/extraction.md and #73
# FX-1 (docs/extraction.md): the artifact set a `profile: full` record must carry.
FX1_ALWAYS = ["normative", "requirements", "design-notes"]
FX1_UNLESS_NA = ["schema", "messages", "protocol", "state-machine", "examples"]
FX1_FILES = {"normative": "distilled/normative.md", "requirements": "distilled/requirements.yaml",
             "design-notes": "distilled/design-notes.md", "schema": "distilled/schema",
             "messages": "distilled/messages.yaml", "protocol": "distilled/protocol.yaml",
             "state-machine": "distilled/state-machine.yaml", "examples": "distilled/examples"}
FX1_PASSES = ["extract", "verify", "cross-check"]
FX1_TYPES = {"rfc", "draft", "spec", "ietf"}

# The summary template's own prompt text. A summary still carrying it was never
# written (library#45: 261 of 293 records sat like this under a green check).
SCAFFOLD = ("_Two to five sentences", "_What this document does not settle", "_TODO")

REL = {"supersedes", "superseded_by", "updates", "updated_by", "cited_by",
       "see_also", "implements_concept", "contradicts", "part_of"}




# Derived-vs-verbatim naming (#44, docs/extraction.md). `.derived.` is
# mandatory on anything the library wrote; `.verbatim.` is optional; an
# unmarked name asserts the source's own bytes. The header marker stays too —
# a header is read only by someone who opens the file, and the citation error
# this guards against happens precisely when the file is not opened.
#
# First marker wins: a verbatim file often names the derived file that
# cross-checks it (rfc-8949's jump table does) and a derived file routinely
# says "DERIVED - not verbatim", so neither word can be tested in isolation.
MARKER = re.compile(r"\b(derived|verbatim)\b", re.I)
# A generation banner ("GENERATED by bin/derive") means the file is derived,
# but it is not the convention's marker vocabulary, so it warns rather than
# errors — the record it currently finds is blocked behind an unrelated FX-1
# gap and cannot be renamed in the same breath. See #73.
GENERATED = re.compile(r"\bgenerated by\b", re.I)
HDR_LINES = 12


def _claim(head):
    """'derived', 'verbatim', or None — what the header says this file is."""
    m = MARKER.search(head)
    if not m:
        return None
    w = m.group(1).lower()
    return "verbatim" if w == "verbatim" else "derived"


def check_derived_naming(recdir, where, errs, warns):
    d = recdir / "distilled" / "schema"
    if not d.is_dir():
        return
    for f in sorted(x for x in d.rglob("*") if x.is_file()):
        rel = f.relative_to(recdir)
        if f.name == "README.md":
            continue  # prose about the directory; it discusses both kinds
        try:
            text = f.read_text(errors="ignore")
        except OSError:
            continue
        head = "\n".join(text.splitlines()[:HDR_LINES])
        named = ".derived." in f.name
        claim = _claim(head)
        if claim == "derived" and not named:
            errs.append(f"{where}: {rel} is marked DERIVED in its header but its name "
                        f"does not carry '.derived.' — docs/extraction.md, "
                        f"Derived vs verbatim")
        if named and claim == "verbatim":
            errs.append(f"{where}: {rel} is named '.derived.' but its header says "
                        f"VERBATIM — one of the two is wrong")
        if ".verbatim." in f.name and claim == "derived":
            errs.append(f"{where}: {rel} is named '.verbatim.' but its header says "
                        f"DERIVED — one of the two is wrong")
        if claim is None and GENERATED.search(head) and not named:
            warns.append(f"{where}: {rel} is generated by this library but its name "
                         f"does not carry '.derived.' — docs/extraction.md, "
                         f"Derived vs verbatim")
        if f.suffix == ".json" and named and '"$id"' in text:
            idv = re.search(r'"\$id"\s*:\s*"([^"]*)"', text)
            if idv and not idv.group(1).startswith("urn:library:"):
                errs.append(f"{where}: {rel} has a $id that is not a "
                            f"urn:library:<record>:<artifact> — docs/extraction.md, Schema $id")


ID_DEF = re.compile(r'^\s*-?\s*id:\s*["\']?([a-z0-9][a-z0-9.\-]*)#((?:R|V|G|N)-[0-9]+)', re.M)
# The lookbehind makes the match start at a real identifier head. Without it,
# a record id broken across a line — `…-cbor#V-0001` — matches on its tail and
# reads as a *foreign* reference, which is how this check first mis-flagged
# draft-mcnally-deterministic-cbor's own paragraph warning about that very wrap.
ID_REF = re.compile(r'(?<![\w.\-…])([a-z0-9][a-z0-9.\-]*?)#((?:R|V|G|N)-[0-9]+)\b')
ID_FILES = {".yaml", ".md", ".txt", ".cddl", ".abnf", ".json"}


def check_artifact_parses(recdir, where, warns):
    """Warn where a distilled/ YAML artifact cannot be read by both readers.

    bin/validate checked only that an artifact's PATH EXISTS, so rfc-8392
    shipped a protocol model and a state machine that bin/_record_yaml.py —
    the reader bin/ingest, bin/fetch-source, bin/_record_html and
    bin/check-locators all import — could not parse at all, and nothing said
    so (library#39). An artifact no reader can read is not an artifact.

    A warning rather than an error: 19 of 308 artifacts in the library are in
    this state already, several in records at profile: full, so erroring would
    fail the build on history instead of on new drift. Library#20 tracks the
    wider divergence between the two readers.
    """
    d = recdir / "distilled"
    if not d.is_dir():
        return
    for f in sorted(x for x in d.rglob("*.yaml") if x.is_file()):
        rel = f.relative_to(recdir)
        try:
            text = f.read_text(errors="ignore")
        except OSError:
            continue
        for name, read in (("bin/_yaml.py", lambda: miniyaml(text)),
                           ("bin/_record_yaml.py", lambda: _record_yaml.load_yaml(f))):
            try:
                read()
            except Exception as e:                       # noqa: BLE001
                warns.append(f"{where}: {rel} cannot be parsed by {name} "
                             f"({type(e).__name__}) — an artifact no reader "
                             f"can read is not an artifact")


def check_id_collisions(recdir, rid, where, warns):
    """Warn where a cited foreign id's bare form is also one of this record's.

    Ids are *defined* record-qualified (`rfc-8949#R-0001`) but prose cites them
    bare. So a record that cites `rfc-8610#R-0079` while also defining its own
    `R-0079` has a bare `R-0079` that resolves two ways, and a prefix-blind
    reader — human or script — silently gets the wrong requirement. Nothing
    else catches it: both ids exist, so no reference is dangling.

    Found by draft-ietf-cbor-cddl-modules' cross-check (#39), whose own
    README listed two of its four cross-record refs and missed both of the
    colliding ones. A warning rather than an error: the collisions predate the
    check and some sit in records already at profile: full.
    """
    own, foreign = set(), {}
    for f in sorted(x for x in recdir.rglob("*") if x.is_file()):
        if f.suffix not in ID_FILES:
            continue
        try:
            text = f.read_text(errors="ignore")
        except OSError:
            continue
        own |= {i for who, i in ID_DEF.findall(text) if who == rid}
        for who, i in ID_REF.findall(text):
            if who != rid:
                foreign.setdefault((who, i), f.relative_to(recdir))
    for (who, i), rel in sorted(foreign.items()):
        if i in own:
            warns.append(f"{where}: cites {who}#{i} while defining its own {i} "
                         f"({rel}) — a bare '{i}' in prose resolves two ways")


def check_full(recdir, d, where, errs):
    """Enforce FX-1 on a record that declares distillation.profile: full."""
    dist = d.get("distillation") or {}
    na = {x.get("kind"): x.get("reason", "") for x in (dist.get("not_applicable") or [])
          if isinstance(x, dict)}
    for k, r in na.items():
        if k in FX1_ALWAYS:
            errs.append(f"{where}: FX-1 — '{k}' is never not-applicable")
        elif not str(r).strip():
            errs.append(f"{where}: FX-1 — not_applicable '{k}' needs a written reason")
    for k in FX1_ALWAYS + FX1_UNLESS_NA:
        if k in na and k not in FX1_ALWAYS:
            continue
        f = recdir / FX1_FILES[k]
        if not f.exists() or (f.is_dir() and not any(f.iterdir())):
            errs.append(f"{where}: FX-1 — missing {k} ({FX1_FILES[k]}) and not declared not_applicable")
            continue
        for g in ([f] if f.is_file() else [x for x in f.rglob("*") if x.is_file()]):
            try:
                if "TODO" in g.read_text(errors="ignore"):
                    errs.append(f"{where}: FX-1 — {g.relative_to(recdir)} still has TODO markers")
            except OSError:
                pass
    if not (recdir / "summary.md").exists():
        errs.append(f"{where}: FX-1 — summary.md required")
    if not d.get("tags") or not d.get("bears_on") or not d.get("topic"):
        errs.append(f"{where}: FX-1 — labels incomplete: tags, bears_on and topic are all required")
    done = {x.get("pass") for x in (dist.get("passes") or []) if isinstance(x, dict)}
    for ps in FX1_PASSES:
        if ps not in done:
            errs.append(f"{where}: FX-1 — pass '{ps}' not recorded in distillation.passes")
    for x in (dist.get("passes") or []):
        if isinstance(x, dict) and str(x.get("effort", "")).lower() != "max":
            errs.append(f"{where}: FX-1 — pass '{x.get('pass')}' ran at effort "
                        f"'{x.get('effort')}'; extraction passes run at max")
    rq = recdir / "distilled/requirements.yaml"
    if rq.exists():
        r = miniyaml(rq.read_text())
        texts = " ".join(str(x.get("text", "")) for x in (r.get("requirements") or [])
                         if isinstance(x, dict))
        got = _bcp14.count(texts, boilerplate=False)
        def num(v, dflt):
            try:
                return int(str(v).split("#")[0].strip().strip('"'))
            except ValueError:
                return dflt
        src = num(r.get("source_keyword_count", -1), -1)
        hdr = num(r.get("extracted_keyword_count", -1), -1)
        recon = str(r.get("reconciliation", "")).strip()
        if src < 0:
            errs.append(f"{where}: FX-1 — requirements.yaml source_keyword_count not set (bin/bcp14-count)")
        elif src == 0 and not recon:
            # A measured zero is legitimate (process standards, regulations and
            # guidance rarely use BCP 14), but then the reconciliation must say
            # which normative forms the extraction counted instead.
            errs.append(f"{where}: FX-1 — source_keyword_count is 0; reconciliation must state "
                        f"the document's own normative baseline (shall/should/tasks/activities)")
        if hdr != got:
            errs.append(f"{where}: FX-1 — extracted_keyword_count says {hdr}, texts contain {got}")
        if src > 0 and got != src and not recon:
            errs.append(f"{where}: FX-1 — source has {src} BCP 14 keywords, extraction has {got}, "
                        f"and no reconciliation explains the difference")


def main():
    errs, warns, n = [], [], 0
    scaffolds, extracted = [], 0
    by_url, by_ident = {}, {}
    dup_of, all_ids, ident_text = {}, set(), {}
    for rec in sorted((ROOT / "records").glob("*/*/record.yaml")):
        n += 1
        rid = rec.parent.name
        body_dir = rec.parent.parent.name
        d = miniyaml(rec.read_text())
        where = f"records/{body_dir}/{rid}"
        if body_dir not in BODIES:
            errs.append(f"{where}: '{body_dir}' is not a known body directory {BODIES}")
        if d.get("body") and d["body"] != body_dir:
            errs.append(f"{where}: body '{d['body']}' does not match its directory '{body_dir}'")
        for k in REQUIRED:
            if k not in d:
                errs.append(f"{where}: missing required field '{k}'")
        if d.get("id") and d["id"] != rid:
            errs.append(f"{where}: id '{d['id']}' != directory name '{rid}'")
        s_md = rec.parent / "summary.md"
        if not s_md.exists() or any(m in s_md.read_text() for m in SCAFFOLD):
            scaffolds.append(where)
        _dd = d.get("distillation")
        if isinstance(_dd, dict) and _dd.get("profile") == "full" and _dd.get("standard") == FX1:
            extracted += 1          # full against the standard in force, not against an older one
        # duplicate detection (library#35): the same document held twice, usually
        # because a second publisher looked like a second document
        all_ids.add(rid)
        if isinstance(d.get("identifiers"), dict):
            ident_text[rid] = " ".join(str(v) for k, v in d["identifiers"].items()
                                       if k != "url" and "://" not in str(v)).lower()
        cu = (d.get("content") or {}).get("url") if isinstance(d.get("content"), dict) else None
        if cu:
            by_url.setdefault(re.sub(r"[/#?]+$", "", str(cu).lower().replace("http://", "https://")), []).append(rid)
        ids = d.get("identifiers")
        if isinstance(ids, dict):
            for k, v in ids.items():
                if k in ("url",) or not isinstance(v, str) or len(v) < 4:
                    continue
                by_ident.setdefault((k, v.strip().lower()), []).append(rid)
        dup = d.get("duplicate_of")
        if dup:
            dup_of[rid] = dup
            # d["status"], not `st`: `st` is assigned further down, so here it
            # still held the previous record's status.
            if d.get("status") != "stub":
                errs.append(f"{where}: duplicate_of {dup} — a duplicate stays a stub pointer; extend '{dup}' instead")
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", rid):
            errs.append(f"{where}: id must be kebab-case")
        if d.get("type") and d["type"] not in TYPES:
            errs.append(f"{where}: unknown type '{d['type']}'")
        st = d.get("status")
        if st and st not in STATUS:
            errs.append(f"{where}: unknown status '{st}'")
        c = d.get("content", {})
        if isinstance(c, dict):
            if str(c.get("local", "false")).lower() == "true":
                errs.append(f"{where}: content.local must be false — we do not commit third-party files")
            if st in {"read", "summarized", "distilled"} and not c.get("sha256"):
                warns.append(f"{where}: status={st} but no content digest")
        # `body` is a shelf, not an authority claim (schema storage.note), so
        # `publisher` is the only field naming who issued the document. Gated
        # on a read status: a stub may legitimately not know yet.
        if st in {"read", "summarized", "distilled"} and not str(d.get("publisher") or "").strip():
            warns.append(f"{where}: status={st} but no publisher — `body` does not "
                         f"record who published this, `publisher` does")
        u = d.get("usefulness", {})
        if isinstance(u, dict) and u:
            vd = u.get("verdict")
            if vd and vd not in VERDICTS:
                errs.append(f"{where}: usefulness.verdict '{vd}' not in {sorted(VERDICTS)}")
            if vd in {"not-useful", "marginal"} and not u.get("reason"):
                errs.append(f"{where}: usefulness.verdict={vd} requires a reason — "
                            f"an unexplained negative verdict gets re-litigated")
        rel = d.get("relations", {})
        if isinstance(rel, dict):
            for k in rel:
                if k not in REL:
                    errs.append(f"{where}: relation '{k}' is not a typed relation {sorted(REL)}")
        summ = rec.parent / "summary.md"
        if st in {"read", "summarized", "distilled"}:
            if not summ.exists():
                errs.append(f"{where}: status={st} requires summary.md")
            else:
                body = summ.read_text()
                if not body.startswith("---"):
                    errs.append(f"{where}: summary.md needs YAML front matter (OKF alignment)")
                if any(m in body for m in SCAFFOLD):
                    errs.append(f"{where}: status={st} but summary.md is still a template")
        # Distillation is progressive: a SET of artifacts under distilled/,
        # not one file. `distilled` means at least one artifact exists.
        dd = rec.parent / "distilled"
        if st == "distilled":
            if not dd.is_dir() or not any(dd.rglob("*")):
                errs.append(f"{where}: status=distilled requires at least one artifact in distilled/")
            elif not (dd / "README.md").exists():
                errs.append(f"{where}: distilled/ needs a README.md indexing its artifacts and their coverage")
        for md in dd.glob("*.md") if dd.is_dir() else []:
            if not md.read_text().startswith("---"):
                errs.append(f"{where}: distilled/{md.name} needs YAML front matter")
        dist = d.get("distillation") or {}
        if isinstance(dist, dict) and dist:
            # The denominator for `profile` (#73). Without it "full" names no
            # standard, and `status: distilled` cannot be read as a claim.
            std = dist.get("standard")
            if not std:
                errs.append(f"{where}: distillation declares no `standard` — say which standard "
                            f"it was measured against (FX-1, distillation/0.1.0, threat-radar)")
            if dist.get("profile") == "partial" and not str(dist.get("profile_reason", "")).strip():
                errs.append(f"{where}: profile: partial needs a `profile_reason` — an unexplained "
                            f"partial is indistinguishable from an abandoned one")
            # FX-1's artifact set is FX-1's. A record measured against an earlier
            # standard is grandfathered and is not held to it.
            if std == FX1 and dist.get("profile") == "full":
                check_full(rec.parent, d, where, errs)
        # Not gated on profile: full — the drift this catches (#44) happens
        # the moment a schema/ directory exists, not when the record finishes.
        check_derived_naming(rec.parent, where, errs, warns)
        check_id_collisions(rec.parent, rid, where, warns)
        check_artifact_parses(rec.parent, where, warns)
        if (rec.parent / "distilled.md").exists():
            errs.append(f"{where}: distilled.md is superseded by distilled/ (schema v5)")
        # A summary must not declare the absence of a distilled/ the record
        # actually has. rfc-8949, rfc-9942 and rfc-9943 each drifted this way
        # when their extraction landed without revisiting summary.md, and
        # validate was clean throughout (library#68). The declared-absence
        # line is now asked of every summary, so a wrong one propagates.
        sm = rec.parent / "summary.md"
        if dd.is_dir() and any(dd.rglob("*")) and sm.exists():
            if re.search(r"(?:^|[\s,])no\s+`distilled/`", sm.read_text(), re.I | re.M):
                errs.append(
                    f"{where}: summary.md declares 'No `distilled/`' but distilled/ "
                    f"exists \u2014 state the artifact set instead"
                )
        # A digest quoted in summary.md must be the one record.yaml records.
        # The summary's metadata table is written by hand, and a hand-written
        # digest is a hand-invented digest: library#39 shipped two wrong ones
        # (rfc-9679, draft-ietf-cbor-serialization), each caught only because a
        # later extraction pass happened to recompute it. In a library that
        # holds digests and URLs INSTEAD of documents, this is the one field
        # whose wrongness defeats the whole arrangement \u2014 a reader cannot tell
        # a typo from a substituted source. Prefixes are allowed because the
        # table elides (`f6b460e38ba1\u2026`); a prefix that does not match the
        # recorded digest is an error, not a warning.
        # Scoped to the metadata table's Digest row ONLY. Prose may legitimately
        # quote a superseded digest \u2014 the IANA registry summaries do exactly
        # that when explaining that a live registry moved under its pinned hash
        # \u2014 so checking every backticked hex string in the file reports those
        # as errors. The table row is the one place that must state the digest
        # this record currently cites.
        recorded = str((d.get("content") or {}).get("sha256") or "")
        if recorded and sm.exists():
            row = re.search(r"^\|\s*\*\*Digest\*\*\s*\|([^|]*)\|", sm.read_text(), re.M)
            if row:
                m = re.search(r"`(?:sha-?256:)?([0-9a-f]{8,64})[\u2026.]*`", row.group(1))
                if m and not recorded.startswith(m.group(1)):
                    errs.append(
                        f"{where}: summary.md's Digest row says {m.group(1)[:16]}\u2026 but "
                        f"content.sha256 is {recorded[:16]}\u2026 \u2014 copy it, never retype it"
                    )
        for f in rec.parent.rglob("*"):
            if f.suffix.lower() in {".pdf", ".xlsx", ".epub", ".docx", ".zip"}:
                errs.append(f"{where}: third-party file committed ({f.name}) — record the digest, not the bytes")

    t = 0
    for top in sorted((ROOT / "topics").glob("*.yaml")):
        t += 1
        d = miniyaml(top.read_text())
        for k in ("id", "question", "owner", "status"):
            if k not in d:
                errs.append(f"topics/{top.name}: missing '{k}'")

    for rid, dup in dup_of.items():
        if dup not in all_ids:
            errs.append(f"records/*/{rid}: duplicate_of '{dup}' is not a record")
    known = set(dup_of) | set(dup_of.values())
    # a record whose id names another record's identifier, e.g. ecma-424 vs
    # cyclonedx-1-7 carrying identifiers.ecma "ECMA-424, 2nd edition"
    for rid in sorted(all_ids):
        pat = re.compile(r"(?<![a-z0-9])" + re.escape(rid).replace(r"\-", r"[- ]") + r"(?![a-z0-9]|-[a-z0-9])")
        for other, txt in ident_text.items():
            if other != rid and rid not in known and other not in known and pat.search(txt):
                warns.append(f"possible duplicate: {rid} is named in {other}'s identifiers")
    for url, rids in sorted(by_url.items()):
        if set(rids) <= known and len(set(rids)) > 1:
            continue
        if len(set(rids)) > 1:
            warns.append(f"possible duplicate: {', '.join(sorted(set(rids)))} share content.url {url}")
    for (k, v), rids in sorted(by_ident.items()):
        if len(set(rids)) > 1:
            warns.append(f"possible duplicate: {', '.join(sorted(set(rids)))} share identifiers.{k} '{v}'")
    if scaffolds:
        warns.append(f"{len(scaffolds)} record(s) still have an unwritten summary scaffold "
                     f"(bin/validate --scaffolds lists them)")
    if "--scaffolds" in sys.argv:
        for s in scaffolds:
            print(f"scaffold  {s}")

    for w in warns:
        print(f"warn  {w}")
    for e in errs:
        print(f"ERROR {e}")
    print(f"\n{n} records ({n - len(scaffolds)} written, {len(scaffolds)} scaffold, "
          f"{extracted} fully extracted), {t} topics — {len(errs)} errors, {len(warns)} warnings")
    return 1 if errs else 0


if __name__ == "__main__":
    sys.exit(main())
