#!/usr/bin/env python3
"""derive — generate distilled artifacts from a record's fields.yaml.

    bin/derive <record-dir> [requirements|cddl|python|rust|all]

Every output names what it was generated_from, so a defect in the field table
can be traced into everything downstream. Generated artifacts are NEVER edited
by hand; fix fields.yaml and regenerate.
"""
import pathlib, re, sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from _yaml import parse

JSON2PY = {"string": "str", "string[]": "list[str]", "integer": "int", "number": "float",
           "boolean": "bool", "object": "dict", "object[]": "list[dict]", "array": "list",
           "unknown": "object"}
JSON2RS = {"string": "String", "string[]": "Vec<String>", "integer": "i64", "number": "f64",
           "boolean": "bool", "object": "serde_json::Value", "object[]": "Vec<serde_json::Value>",
           "array": "Vec<serde_json::Value>", "unknown": "serde_json::Value"}
JSON2CDDL = {"string": "tstr", "string[]": "[* tstr]", "integer": "int", "number": "float",
             "boolean": "bool", "object": "{ * tstr => any }", "object[]": "[* { * tstr => any }]",
             "array": "[* any]", "unknown": "any"}


def load(d):
    y = parse((d / "distilled" / "fields.yaml").read_text())
    meta = {k: y.get(k, "") for k in ("record", "source_version", "extracted", "reviewed_by")}
    return meta, [f for f in y.get("fields", []) if isinstance(f, dict)]


def snake(s):
    return re.sub(r"[^a-z0-9_]", "_", s.lower())


def pascal(s):
    """Object names in specs are not always valid type names."""
    return "".join(w[:1].upper() + w[1:] for w in re.split(r"[^A-Za-z0-9]+", s) if w)


def requirements(meta, fields, digest):
    """Each requirement gets an externally resolvable id."""
    out = [f'''schema: "library-requirements/v1"
record: {meta["record"]}
source_version: "{meta["source_version"]}"
source_digest: "{digest}"
generated_from: distilled/fields.yaml
generated_by: bin/derive
reviewed_by: ""
note: >
  Ids are stable and never reused. Cite as {meta["record"]}#R-NNNN; resolving
  yields locator, source_version, source_digest, verb and verbatim text.

requirements:''']
    n = 0
    for f in fields:
        if f.get("verb", "none") in ("none", ""):
            continue
        n += 1
        out.append(f'''  - id: {meta["record"]}#R-{n:04d}
    object: {f.get("object","")}
    field: {f.get("field","")}
    verb: {f.get("verb")}
    actor: "{'producer' if f.get('verb','').startswith(('MUST','SHALL')) else 'implementation'}"
    locator: "{f.get("locator","")}"
    text: "{str(f.get("text", f.get("semantics",""))).replace('"', "'")}"
    kind: {f.get("kind","stated")}
    testable: {f.get("testable","TODO")}
    status: active''')
    out.append(f"\n# {n} requirements derived from {len(fields)} fields")
    return "\n".join(out) + "\n", n


def cddl(meta, fields):
    objs = {}
    for f in fields:
        objs.setdefault(f.get("object", "?"), []).append(f)
    out = [f"; GENERATED by bin/derive from distilled/fields.yaml — do not edit",
           f"; source: {meta['record']} {meta['source_version']}", ""]
    for o, fs in objs.items():
        out.append(f"{snake(o)} = {{")
        for f in fs:
            opt = "" if str(f.get("required")) == "true" else "? "
            out.append(f'  {opt}"{f.get("field")}" => {JSON2CDDL.get(f.get("json_type","unknown"),"any")},'
                       f'  ; {f.get("locator","")} {f.get("verb","")}')
        out.append("}\n")
    return "\n".join(out)


def python(meta, fields):
    objs = {}
    for f in fields:
        objs.setdefault(f.get("object", "?"), []).append(f)
    out = ['"""GENERATED by bin/derive from distilled/fields.yaml — do not edit.',
           f'Source: {meta["record"]} {meta["source_version"]}',
           '',
           'Types only. Two things these types deliberately do NOT express:',
           '  - per-type applicability (vCon §4.3.1.6): a field being present is not',
           '    sufficient, it must be valid FOR THE type value.',
           '  - a MUST on a field VALUE is not a MUST on its PRESENCE. `vcon` carries',
           '    a MUST constraining its value yet is optional; the generator cannot',
           '    tell those apart, so required-ness comes from the field table.',
           '"""',
           'from __future__ import annotations',
           'from dataclasses import dataclass, field',
           'from typing import Any', '']
    for o, fs in objs.items():
        out.append("@dataclass")
        out.append(f"class {pascal(o)}:")
        req = [f for f in fs if str(f.get("required")) == "true"]
        opt = [f for f in fs if str(f.get("required")) != "true"]
        if not fs:
            out.append("    pass")
        for f in req:
            out.append(f'    {snake(f["field"])}: {JSON2PY.get(f.get("json_type","unknown"),"Any")}'
                       f'  # {f.get("locator")} {f.get("verb")}')
        for f in opt:
            out.append(f'    {snake(f["field"])}: {JSON2PY.get(f.get("json_type","unknown"),"Any")} | None = None'
                       f'  # {f.get("locator")} {f.get("verb","")}')
        out.append("")
    return "\n".join(out)


def rust(meta, fields):
    objs = {}
    for f in fields:
        objs.setdefault(f.get("object", "?"), []).append(f)
    out = ["// GENERATED by bin/derive from distilled/fields.yaml — do not edit.",
           f"// Source: {meta['record']} {meta['source_version']}",
           "// Types only; per-type applicability rules are not expressed here.",
           "use serde::{Deserialize, Serialize};", ""]
    for o, fs in objs.items():
        out.append("#[derive(Debug, Clone, Serialize, Deserialize)]")
        out.append(f"pub struct {pascal(o)} {{")
        for f in fs:
            ty = JSON2RS.get(f.get("json_type", "unknown"), "serde_json::Value")
            if str(f.get("required")) != "true":
                ty = f"Option<{ty}>"
                out.append('    #[serde(skip_serializing_if = "Option::is_none")]')
            out.append(f'    pub {snake(f["field"])}: {ty},  // {f.get("locator")} {f.get("verb","")}')
        out.append("}\n")
    return "\n".join(out)


def main():
    d = pathlib.Path(sys.argv[1])
    what = sys.argv[2] if len(sys.argv) > 2 else "all"
    meta, fields = load(d)
    rec = parse((d / "record.yaml").read_text())
    digest = (rec.get("content", {}) or {}).get("sha256", "")
    dd = d / "distilled"
    made = []
    if what in ("requirements", "all"):
        txt, n = requirements(meta, fields, digest)
        (dd / "requirements.yaml").write_text(txt); made.append(f"requirements.yaml ({n})")
    if what in ("cddl", "all"):
        (dd / "schema" / "types.cddl").write_text(cddl(meta, fields)); made.append("schema/types.cddl")
    if what in ("python", "all"):
        (dd / "code" / "types.py").write_text(python(meta, fields)); made.append("code/types.py")
    if what in ("rust", "all"):
        (dd / "code" / "types.rs").write_text(rust(meta, fields)); made.append("code/types.rs")
    print("  derived: " + ", ".join(made))


if __name__ == "__main__":
    main()
